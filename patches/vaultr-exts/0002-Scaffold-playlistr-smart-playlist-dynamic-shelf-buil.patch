+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { PlaylistrExtension } from '../dist/playlistr/index.js';
+
+function createMockHost() {
+  const logs = [];
+  return {
+    log: (entry) => logs.push(entry),
+    getFiles: () => [],
+    getFileByPath: () => undefined,
+    saveSidecar: async () => {},
+    executeRclonePreview: () => {},
+    logs
+  };
+}
+
+test('PlaylistrExtension evaluates dynamic shelf conditions without live disk access', () => {
+  const host = createMockHost();
+  const ext = new PlaylistrExtension();
+  ext.init(host);
+
+  const indexedFiles = [
+    {
+      path: 'music/synthwave/track1.mp3',
+      remote: 'local',
+      remotePath: 'music/synthwave/track1.mp3',
+      md5: 'md5_1',
+      size: 5000000,
+      mtime: '2026-05-01',
+      mimeOrExt: 'mp3',
+      tags: ['synthwave', 'instrumental'],
+      custom: { title: 'Neon Horizon', artist: 'Lazerhawk', album: 'Redline' }
+    },
+    {
+      path: 'music/rock/song2.flac',
+      remote: 'koofr:',
+      remotePath: 'FLACs/song2.flac',
+      md5: 'md5_2',
+      size: 30000000,
+      mtime: '2026-05-02',
+      mimeOrExt: 'flac',
+      tags: ['rock'],
+      custom: { title: 'Stone Age', artist: 'Queens', album: 'Songs' }
+    },
+    {
+      path: 'docs/manual.pdf',
+      remote: 'local',
+      remotePath: 'docs/manual.pdf',
+      md5: 'md5_3',
+      size: 200000,
+      mtime: '2026-05-03',
+      mimeOrExt: 'pdf',
+      tags: ['docs']
+    }
+  ];
+
+  const rule = {
+    id: 'shelf-synthwave',
+    name: 'Synthwave Classics',
+    matchType: 'AND',
+    conditions: [
+      { field: 'ext', operator: 'in', value: ['mp3', 'flac'] },
+      { field: 'tags', operator: 'in', value: ['synthwave'] }
+    ],
+    sortBy: 'title',
+    sortOrder: 'asc'
+  };
+
+  const playlist = ext.evaluateRules(indexedFiles, rule);
+  assert.equal(playlist.length, 1);
+  assert.equal(playlist[0].title, 'Neon Horizon');
+  assert.equal(playlist[0].artist, 'Lazerhawk');
+  assert.equal(playlist[0].fetchStatus, 'cached-local');
+});
+
+test('PlaylistrExtension generates valid VLC-compatible .m3u8 playlist', () => {
+  const host = createMockHost();
+  const ext = new PlaylistrExtension();
+  ext.init(host);
+
+  const items = [
+    {
+      id: 'track1',
+      title: 'Track One',
+      artist: 'Artist A',
+      album: 'Album 1',
+      durationSeconds: 180,
+      path: 'Z:/Music/track1.mp3',
+      remote: 'Z:',
+      remotePath: 'Music/track1.mp3',
+      fetchStatus: 'indexed-only',
+      mimeOrExt: 'mp3',
+      size: 4000000
+    }
+  ];
+
+  const m3u8 = ext.generateM3u8('My Chill Mix', items);
+  assert.ok(m3u8.startsWith('#EXTM3U\n#PLAYLIST:My Chill Mix'));
+  assert.ok(m3u8.includes('#EXTINF:180,Artist A - Track One'));
+  assert.ok(m3u8.includes('Z:/Music/track1.mp3'));
+});
+
+test('PlaylistrExtension generates flat .anymd YAML sidecar for smart playlist persistence', () => {
+  const host = createMockHost();
+  const ext = new PlaylistrExtension();
+  ext.init(host);
+
+  const rule = {
+    id: 'shelf-favs',
+    name: 'Favorite Tracks',
+    matchType: 'AND',
+    conditions: [{ field: 'ext', operator: 'equals', value: 'mp3' }]
+  };
+
+  const items = [
+    {
+      id: 'item1',
+      title: 'Favorite Song',
+      artist: 'Singer',
+      path: 'songs/fav.mp3',
+      remote: 'local',
+      remotePath: 'songs/fav.mp3',
+      fetchStatus: 'cached-local',
+      mimeOrExt: 'mp3',
+      size: 5000000
+    }
+  ];
+
+  const sidecar = ext.generatePlaylistSidecar(rule, items);
+  assert.ok(sidecar.startsWith('---\nid: "shelf-favs"'));
+  assert.ok(sidecar.includes('type: smart-playlist'));
+  assert.ok(sidecar.includes('# Smart Playlist: Favorite Tracks'));
+  assert.ok(sidecar.includes('| 1 | Favorite Song | Singer | `local` | cached-local | 5000000 |'));
+});
+
+test('PlaylistrExtension outputs rclone --files-from manifest for remote track pre-fetch', () => {
+  const host = createMockHost();
+  const ext = new PlaylistrExtension();
+  ext.init(host);
+
+  const items = [
+    {
+      id: 'local1',
+      title: 'Local',
+      path: 'music/local.mp3',
+      remote: 'local',
+      remotePath: 'music/local.mp3',
+      fetchStatus: 'cached-local',
+      mimeOrExt: 'mp3',
+      size: 1000
+    },
+    {
+      id: 'remote1',
+      title: 'Cloud Track',
+      path: 'koofr:/audio/cloud.mp3',
+      remote: 'koofr:',
+      remotePath: 'audio/cloud.mp3',
+      fetchStatus: 'indexed-only',
+      mimeOrExt: 'mp3',
+      size: 6000000
+    }
+  ];
+
+  const { manifestLines, commandPreview } = ext.generateRcloneFilesFromManifest(items, 'koofr:');
+  assert.equal(manifestLines.length, 1);
+  assert.equal(manifestLines[0], 'audio/cloud.mp3');
+  assert.ok(commandPreview.includes('rclone copy "koofr:" "local:cached_playlists" --files-from="playlist_fetch_list.txt" --no-traverse --dry-run'));
+});
