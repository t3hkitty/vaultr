+import type { VaultrFileMetadata } from '../types.js';
+
+export type FetchStatus = 'cached-local' | 'indexed-only' | 'syncing' | 'failed';
+
+export interface PlaylistRuleCondition {
+  field: 'ext' | 'mime' | 'tags' | 'artist' | 'album' | 'vault_zone' | 'backend' | 'fetch_status' | 'path';
+  operator: 'equals' | 'contains' | 'in' | 'not-in' | 'matches';
+  value: string | string[];
+}
+
+export interface PlaylistRuleDefinition {
+  id: string;
+  name: string;
+  description?: string;
+  matchType: 'AND' | 'OR';
+  conditions: PlaylistRuleCondition[];
+  sortBy?: 'title' | 'artist' | 'mtime' | 'size' | 'random';
+  sortOrder?: 'asc' | 'desc';
+  maxTracks?: number; // Optional limit (e.g. 50 or 100)
+}
+
+export interface ResolvedPlaylistItem {
+  id: string;
+  title: string;
+  artist?: string;
+  album?: string;
+  durationSeconds?: number;
+  path: string;
+  remote: string;
+  remotePath: string;
+  fetchStatus: FetchStatus;
+  mimeOrExt: string;
+  size: number;
+}
+
+export interface SmartPlaylistRecord {
+  rule: PlaylistRuleDefinition;
+  generatedAt: string;
+  totalTracks: number;
+  totalBytes: number;
+  items: ResolvedPlaylistItem[];
+}
