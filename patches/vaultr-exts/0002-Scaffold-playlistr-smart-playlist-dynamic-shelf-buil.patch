+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi,
+  VaultrFileMetadata
+} from '../types.js';
+import type {
+  PlaylistRuleDefinition,
+  PlaylistRuleCondition,
+  ResolvedPlaylistItem,
+  SmartPlaylistRecord,
+  FetchStatus
+} from './types.js';
+
+export class PlaylistrExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-playlistr',
+    name: 'Playlistr Dynamic-Shelf Playlist Builder',
+    version: '0.1.0',
+    description: 'Generates smart audio/video playlists from .anymd sidecars using Kittlibr-style dynamic shelf rules, exporting to .m3u8, HTML5 queues, and rclone --files-from prefetch.',
+    category: 'organizer',
+    author: 't3hkitty',
+    entrypoint: 'extensions/playlistr/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/playlistr',
+    enabledByDefault: true,
+    capabilities: [
+      'dynamic-shelf-evaluation',
+      'm3u8-export',
+      'anymd-playlist-sidecar',
+      'rclone-files-from-prefetch',
+      'html5-queue-bridge'
+    ]
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr:playlistr',
+      stage: 'init',
+      message: 'Playlistr Dynamic-Shelf Playlist extension initialized.'
+    });
+  }
+
+  /**
+   * Evaluates dynamic shelf rules against indexed .anymd sidecars without touching live drives
+   */
+  public evaluateRules(files: VaultrFileMetadata[], rule: PlaylistRuleDefinition): ResolvedPlaylistItem[] {
+    const matchedFiles: VaultrFileMetadata[] = [];
+
+    for (const file of files) {
+      const isMatch = this.matchesConditions(file, rule.conditions, rule.matchType);
+      if (isMatch) {
+        matchedFiles.push(file);
+      }
+    }
+
+    // Sort
+    if (rule.sortBy === 'random') {
+      matchedFiles.sort(() => Math.random() - 0.5);
+    } else {
+      matchedFiles.sort((a, b) => {
+        let valA = '';
+        let valB = '';
+
+        if (rule.sortBy === 'artist') {
+          valA = String((a.custom?.artist as string) || (a.custom?.author as string) || '');
+          valB = String((b.custom?.artist as string) || (b.custom?.author as string) || '');
+        } else if (rule.sortBy === 'mtime') {
+          valA = a.mtime || '';
+          valB = b.mtime || '';
+        } else if (rule.sortBy === 'size') {
+          return (rule.sortOrder === 'desc' ? -1 : 1) * (a.size - b.size);
+        } else {
+          // Default: path / title
+          valA = a.path;
+          valB = b.path;
+        }
+
+        const cmp = valA.localeCompare(valB);
+        return rule.sortOrder === 'desc' ? -cmp : cmp;
+      });
+    }
+
+    // Apply max limit
+    const sliced = rule.maxTracks && rule.maxTracks > 0 ? matchedFiles.slice(0, rule.maxTracks) : matchedFiles;
+
+    const resolved: ResolvedPlaylistItem[] = sliced.map(f => {
+      const filename = f.path.split(/[\/\\]/).pop() || 'Track';
+      const cleanTitle = filename.replace(/\.[^/.]+$/, '');
+      const fetchStatus: FetchStatus = f.remote.toLowerCase() === 'local' ? 'cached-local' : 'indexed-only';
+
+      return {
+        id: f.md5 || f.path,
+        title: String(f.custom?.title || cleanTitle),
+        artist: (f.custom?.artist as string) || (f.custom?.author as string),
+        album: (f.custom?.album as string) || (f.custom?.series as string),
+        durationSeconds: Number(f.custom?.duration) || undefined,
+        path: f.path,
+        remote: f.remote,
+        remotePath: f.remotePath,
+        fetchStatus,
+        mimeOrExt: f.mimeOrExt,
+        size: f.size
+      };
+    });
+
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr:playlistr',
+      stage: 'shelf-eval',
+      message: `Dynamic shelf "${rule.name}" resolved ${resolved.length} tracks.`,
+      meta: { ruleId: rule.id, count: resolved.length }
+    });
+
+    return resolved;
+  }
+
+  private matchesConditions(
+    file: VaultrFileMetadata,
+    conditions: PlaylistRuleCondition[],
+    matchType: 'AND' | 'OR'
+  ): boolean {
+    if (!conditions || conditions.length === 0) return true;
+
+    for (const cond of conditions) {
+      const res = this.evalSingleCondition(file, cond);
+      if (matchType === 'AND' && !res) return false;
+      if (matchType === 'OR' && res) return true;
+    }
+
+    return matchType === 'AND';
+  }
+
+  private evalSingleCondition(file: VaultrFileMetadata, cond: PlaylistRuleCondition): boolean {
+    let actualValue = '';
+    let actualList: string[] = [];
+
+    switch (cond.field) {
+      case 'ext':
+      case 'mime':
+        actualValue = (file.mimeOrExt || file.path.split('.').pop() || '').toLowerCase();
+        break;
+      case 'tags':
+        actualList = (file.tags || []).map(t => t.toLowerCase());
+        break;
+      case 'artist':
+        actualValue = String(file.custom?.artist || file.custom?.author || '').toLowerCase();
+        break;
+      case 'album':
+        actualValue = String(file.custom?.album || file.custom?.series || '').toLowerCase();
+        break;
+      case 'vault_zone':
+      case 'backend':
+        actualValue = (file.remote || '').toLowerCase();
+        break;
+      case 'fetch_status':
+        actualValue = file.remote.toLowerCase() === 'local' ? 'cached-local' : 'indexed-only';
+        break;
+      case 'path':
+        actualValue = file.path.toLowerCase();
+        break;
+    }
+
+    const expectedVal = Array.isArray(cond.value)
+      ? cond.value.map(v => v.toLowerCase())
+      : cond.value.toLowerCase();
+
+    if (cond.operator === 'equals') {
+      return actualValue === expectedVal;
+    }
+    if (cond.operator === 'contains') {
+      return actualValue.includes(expectedVal as string);
+    }
+    if (cond.operator === 'in') {
+      const arr = Array.isArray(expectedVal) ? expectedVal : [expectedVal];
+      if (cond.field === 'tags') {
+        return arr.some(v => actualList.includes(v));
+      }
+      return arr.includes(actualValue);
+    }
+    if (cond.operator === 'not-in') {
+      const arr = Array.isArray(expectedVal) ? expectedVal : [expectedVal];
+      if (cond.field === 'tags') {
+        return !arr.some(v => actualList.includes(v));
+      }
+      return !arr.includes(actualValue);
+    }
+    if (cond.operator === 'matches') {
+      try {
+        const re = new RegExp(expectedVal as string, 'i');
+        return re.test(actualValue);
+      } catch {
+        return false;
+      }
+    }
+
+    return false;
+  }
+
+  /**
+   * Generates standard extended M3U8 string compatible with VLC on Windows and Android
+   */
+  public generateM3u8(playlistName: string, items: ResolvedPlaylistItem[], options: { prefixPath?: string } = {}): string {
+    const lines = ['#EXTM3U', `#PLAYLIST:${playlistName}`];
+
+    for (const item of items) {
+      const duration = item.durationSeconds ?? -1;
+      const artist = item.artist ? `${item.artist} - ` : '';
+      lines.push(`#EXTINF:${duration},${artist}${item.title}`);
+
+      // Path format: local path or mounted drive path
+      let fileUri = item.path;
+      if (options.prefixPath) {
+        fileUri = `${options.prefixPath.replace(/\/$/, '')}/${item.path.replace(/^\//, '')}`;
+      }
+      lines.push(fileUri);
+    }
+
+    return lines.join('\n');
+  }
+
+  /**
+   * Generates a flat .anymd YAML frontmatter file preserving rule definition and resolved tracks
+   */
+  public generatePlaylistSidecar(rule: PlaylistRuleDefinition, items: ResolvedPlaylistItem[]): string {
+    const totalBytes = items.reduce((acc, it) => acc + (it.size || 0), 0);
+
+    const record: SmartPlaylistRecord = {
+      rule,
+      generatedAt: new Date().toISOString(),
+      totalTracks: items.length,
+      totalBytes,
+      items
+    };
+
+    const lines: string[] = ['---'];
+    lines.push(`id: "${rule.id}"`);
+    lines.push(`name: "${rule.name}"`);
+    lines.push(`type: smart-playlist`);
+    lines.push(`generatedAt: "${record.generatedAt}"`);
+    lines.push(`totalTracks: ${items.length}`);
+    lines.push(`totalBytes: ${totalBytes}`);
+    lines.push('rule:');
+    lines.push(`  matchType: ${rule.matchType}`);
+    lines.push(`  sortBy: ${rule.sortBy || 'title'}`);
+    lines.push(`  sortOrder: ${rule.sortOrder || 'asc'}`);
+    lines.push('  conditions:');
+    for (const c of rule.conditions) {
+      lines.push(`    - field: ${c.field}`);
+      lines.push(`      operator: ${c.operator}`);
+      lines.push(`      value: ${JSON.stringify(c.value)}`);
+    }
+    lines.push('---');
+    lines.push('');
+    lines.push(`# Smart Playlist: ${rule.name}`);
+    lines.push(`*Generated from .anymd sidecars across active vaults.*`);
+    lines.push('');
+    lines.push('| # | Title | Artist / Creator | Remote | Status | Size |');
+    lines.push('|---|-------|------------------|--------|--------|------|');
+
+    items.forEach((it, idx) => {
+      lines.push(`| ${idx + 1} | ${it.title} | ${it.artist || '-'} | \`${it.remote}\` | ${it.fetchStatus} | ${it.size} |`);
+    });
+
+    return lines.join('\n');
+  }
+
+  /**
+   * Generates an rclone --files-from manifest list to pull down any indexed-only remote tracks
+   */
+  public generateRcloneFilesFromManifest(
+    items: ResolvedPlaylistItem[],
+    targetRemote?: string
+  ): { manifestLines: string[]; commandPreview: string } {
+    const remoteItems = items.filter(it => it.fetchStatus === 'indexed-only');
+    const filtered = targetRemote
+      ? remoteItems.filter(it => it.remote.toLowerCase() === targetRemote.toLowerCase())
+      : remoteItems;
+
+    const manifestLines = filtered.map(it => it.remotePath || it.path);
+    const remoteSource = targetRemote || (filtered[0]?.remote || 'koofr:');
+    const commandPreview = `rclone copy "${remoteSource}" "local:cached_playlists" --files-from="playlist_fetch_list.txt" --no-traverse --dry-run`;
+
+    return {
+      manifestLines,
+      commandPreview
+    };
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new PlaylistrExtension();
+}
