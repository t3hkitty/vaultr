+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi
+} from '../types.js';
+
+export interface PandocConversionSpec {
+  inputPath: string;
+  outputPath: string;
+  fromFormat?: string;
+  toFormat: string;
+  extraArgs?: string[];
+}
+
+export class PandocConverterExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-pandoc-converter',
+    name: 'Pandoc Document Converter',
+    version: '0.1.0',
+    description: 'Pandoc-based document conversion pipeline (epub, md, html, docx, pdf) with sidecar metadata retention.',
+    category: 'converter',
+    author: 't3hkitty',
+    entrypoint: 'extensions/pandoc/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/pandoc',
+    enabledByDefault: true,
+    capabilities: ['pandoc-conversion', 'sidecar-metadata-preserve']
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr-pandoc-converter',
+      stage: 'init',
+      message: 'Pandoc Converter extension initialized.'
+    });
+  }
+
+  /**
+   * Generates safe pandoc command execution line
+   */
+  public buildPandocCommand(spec: PandocConversionSpec): { command: string; args: string[]; fullCommandLine: string } {
+    const args = [spec.inputPath, '-o', spec.outputPath];
+    if (spec.fromFormat) {
+      args.unshift(`-f`, spec.fromFormat);
+    }
+    if (spec.toFormat) {
+      args.push(`-t`, spec.toFormat);
+    }
+    if (spec.extraArgs) {
+      args.push(...spec.extraArgs);
+    }
+
+    const fullCommandLine = `pandoc ${args.map(a => (a.includes(' ') ? `"${a}"` : a)).join(' ')}`;
+    return {
+      command: 'pandoc',
+      args,
+      fullCommandLine
+    };
+  }
+
+  /**
+   * Builds converted file sidecar preserving existing tags and frontmatter
+   */
+  public createConvertedSidecar(
+    originalPath: string,
+    newOutputPath: string,
+    newExt: string
+  ): void {
+    const originalMeta = this.hostApi.getFileByPath(originalPath);
+    if (!originalMeta) return;
+
+    const convertedMeta = {
+      ...originalMeta,
+      path: newOutputPath,
+      remotePath: newOutputPath,
+      mimeOrExt: newExt,
+      tags: [...originalMeta.tags, `converted-from:${originalMeta.mimeOrExt}`],
+      mtime: new Date().toISOString()
+    };
+
+    this.hostApi.saveSidecar(convertedMeta, `# Converted from ${originalPath}\nSource format: ${originalMeta.mimeOrExt}`);
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new PandocConverterExtension();
+}
diff --git a/extensions/tagger/index.ts b/extensions/tagger/index.ts
