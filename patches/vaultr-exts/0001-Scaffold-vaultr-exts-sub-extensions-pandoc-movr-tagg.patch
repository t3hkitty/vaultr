@@ -0,0 +1,128 @@
+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi,
+  VaultrFileMetadata
+} from '../types.js';
+
+export interface BackupArchiveManifest {
+  archiveId: string;
+  createdAt: string;
+  sourceRemote: string;
+  destinationRemote: string;
+  totalFiles: number;
+  totalBytes: number;
+  checksumAlgorithm: 'md5';
+  manifestSidecarPath: string;
+  files: Array<{
+    path: string;
+    md5: string;
+    size: number;
+    mtime: string;
+    status: 'backed_up' | 'verified' | 'failed';
+  }>;
+}
+
+export class BackupManifestExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-backup-manifest',
+    name: 'Vaultr Backup & Sidecar Manifest System',
+    version: '0.1.0',
+    description: 'Archive and backup orchestrator with sidecar verification manifests, MD5 checksum confirmation, and rclone sync integration.',
+    category: 'backup',
+    author: 't3hkitty',
+    entrypoint: 'extensions/backup/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/backup',
+    enabledByDefault: true,
+    capabilities: ['archive-creation', 'sidecar-manifest-verify', 'md5-backup-audit']
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr-backup-manifest',
+      stage: 'init',
+      message: 'Backup Manifest extension initialized.'
+    });
+  }
+
+  /**
+   * Generates a backup archive manifest sidecar record from indexed files
+   */
+  public createBackupManifest(
+    files: VaultrFileMetadata[],
+    sourceRemote: string,
+    destinationRemote: string
+  ): BackupArchiveManifest {
+    const archiveId = `backup_${Date.now()}`;
+    const totalBytes = files.reduce((acc, f) => acc + (f.size || 0), 0);
+
+    const manifest: BackupArchiveManifest = {
+      archiveId,
+      createdAt: new Date().toISOString(),
+      sourceRemote,
+      destinationRemote,
+      totalFiles: files.length,
+      totalBytes,
+      checksumAlgorithm: 'md5',
+      manifestSidecarPath: `.manifests/${archiveId}.anymd`,
+      files: files.map(f => ({
+        path: f.path,
+        md5: f.md5,
+        size: f.size,
+        mtime: f.mtime,
+        status: 'backed_up'
+      }))
+    };
+
+    return manifest;
+  }
+
+  /**
+   * Verifies existing backup files against the manifest checksums
+   */
+  public verifyBackup(
+    manifest: BackupArchiveManifest,
+    targetFiles: VaultrFileMetadata[]
+  ): { verified: boolean; matchedCount: number; mismatches: string[] } {
+    const targetMap = new Map(targetFiles.map(f => [f.path, f.md5.toLowerCase()]));
+    const mismatches: string[] = [];
+    let matchedCount = 0;
+
+    for (const record of manifest.files) {
+      const actualMd5 = targetMap.get(record.path);
+      if (!actualMd5) {
+        mismatches.push(`Missing: ${record.path}`);
+      } else if (actualMd5 !== record.md5.toLowerCase()) {
+        mismatches.push(`Checksum mismatch for ${record.path}: expected ${record.md5}, found ${actualMd5}`);
+      } else {
+        matchedCount++;
+      }
+    }
+
+    return {
+      verified: mismatches.length === 0,
+      matchedCount,
+      mismatches
+    };
+  }
+
+  /**
+   * Builds the targeted rclone backup copy command using --files-from
+   */
+  public buildBackupRcloneCommand(
+    sourceRemote: string,
+    destRemote: string,
+    manifestListFilePath: string
+  ): string {
+    return `rclone copy "${sourceRemote}" "${destRemote}" --files-from="${manifestListFilePath}" --checksum --dry-run`;
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new BackupManifestExtension();
+}
