diff --git a/tests/extensions.test.mjs b/tests/extensions.test.mjs
new file mode 100644
index 0000000..2a3ab9d
--- /dev/null
+++ b/tests/extensions.test.mjs
@@ -0,0 +1,154 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { PandocConverterExtension } from '../dist/pandoc/index.js';
+import { MovrOrganizerExtension } from '../dist/movr/index.js';
+import { ContentTaggerExtension } from '../dist/tagger/index.js';
+import { KittlibrMetadataExtension } from '../dist/kittlibr/index.js';
+import { BackupManifestExtension } from '../dist/backup/index.js';
+
+function createMockHost() {
+  const logs = [];
+  return {
+    log: (entry) => logs.push(entry),
+    getFiles: () => [],
+    getFileByPath: () => undefined,
+    saveSidecar: async () => {},
+    executeRclonePreview: () => {},
+    logs
+  };
+}
+
+test('PandocConverterExtension builds valid conversion commands', () => {
+  const mockHost = createMockHost();
+  const ext = new PandocConverterExtension();
+  ext.init(mockHost);
+
+  const cmd = ext.buildPandocCommand({
+    inputPath: 'notes/guide.md',
+    outputPath: 'notes/guide.epub',
+    fromFormat: 'markdown',
+    toFormat: 'epub'
+  });
+
+  assert.equal(cmd.command, 'pandoc');
+  assert.equal(cmd.fullCommandLine, 'pandoc -f markdown notes/guide.md -o notes/guide.epub -t epub');
+  assert.ok(mockHost.logs.length > 0);
+});
+
+test('MovrOrganizerExtension creates rules-based rclone move plans', () => {
+  const mockHost = createMockHost();
+  const ext = new MovrOrganizerExtension();
+  ext.init(mockHost);
+
+  const files = [
+    {
+      path: 'inbox/paper.pdf',
+      remote: 'koofr:',
+      remotePath: 'inbox/paper.pdf',
+      md5: '123456',
+      size: 1024,
+      mtime: '2026-01-01',
+      mimeOrExt: 'pdf',
+      tags: []
+    }
+  ];
+
+  const rules = [
+    { matchField: 'mimeOrExt', pattern: 'pdf', targetFolder: 'Documents/PDFs' }
+  ];
+
+  const plan = ext.generateOrganizationPlan(files, rules);
+  assert.equal(plan.length, 1);
+  assert.equal(plan[0].destinationPath, 'Documents/PDFs/paper.pdf');
+  assert.ok(plan[0].rcloneCommand.includes('rclone moveto "koofr:inbox/paper.pdf" "koofr:Documents/PDFs/paper.pdf" --dry-run'));
+});
+
+test('ContentTaggerExtension auto-evaluates tags from content and metadata', () => {
+  const mockHost = createMockHost();
+  const ext = new ContentTaggerExtension();
+  ext.init(mockHost);
+
+  const file = {
+    path: 'library/cybernetics.epub',
+    remote: 'local',
+    remotePath: 'library/cybernetics.epub',
+    md5: '78910',
+    size: 2048,
+    mtime: '2026-02-01',
+    mimeOrExt: 'epub',
+    tags: ['reading']
+  };
+
+  const rules = [
+    { tag: 'tech', keywords: ['cybernetics', 'ai'], extensions: ['epub', 'pdf'] }
+  ];
+
+  const tags = ext.evaluateTags(file, 'Introduction to neural feedback and cybernetics', rules);
+  assert.ok(tags.includes('reading'));
+  assert.ok(tags.includes('tech'));
+});
+
+test('KittlibrMetadataExtension enriches sidecar metadata with book schema and symlink', () => {
+  const mockHost = createMockHost();
+  const ext = new KittlibrMetadataExtension();
+  ext.init(mockHost);
+
+  const file = {
+    path: 'books/neuromancer.epub',
+    remote: 'local',
+    remotePath: 'books/neuromancer.epub',
+    md5: 'aaaabbbb',
+    size: 500000,
+    mtime: '2026-03-01',
+    mimeOrExt: 'epub',
+    tags: ['scifi']
+  };
+
+  const enriched = ext.enrichMetadata(file, {
+    isbn: '9780441569595',
+    title: 'Neuromancer',
+    author: 'William Gibson',
+    series: 'Sprawl #1',
+    tags: ['cyberpunk']
+  });
+
+  assert.ok(enriched.tags.includes('scifi'));
+  assert.ok(enriched.tags.includes('cyberpunk'));
+  assert.equal(enriched.custom?.kittlibr?.isbn, '9780441569595');
+
+  const symlinkCmd = ext.buildSymlinkCommand('/central/kittlibr/notes.anymd', '/vault/books/notes.anymd');
+  assert.equal(symlinkCmd, 'ln -s "/central/kittlibr/notes.anymd" "/vault/books/notes.anymd"');
+});
+
+test('BackupManifestExtension generates archive manifest and verifies checksums', () => {
+  const mockHost = createMockHost();
+  const ext = new BackupManifestExtension();
+  ext.init(mockHost);
+
+  const files = [
+    {
+      path: 'vault/fileA.txt',
+      remote: 'local',
+      remotePath: 'vault/fileA.txt',
+      md5: 'md5_A',
+      size: 100,
+      mtime: '2026-01-01',
+      mimeOrExt: 'txt',
+      tags: []
+    }
+  ];
+
+  const manifest = ext.createBackupManifest(files, 'local', 'koofr:backup');
+  assert.equal(manifest.totalFiles, 1);
+  assert.equal(manifest.files[0].path, 'vault/fileA.txt');
+
+  const verifySuccess = ext.verifyBackup(manifest, files);
+  assert.equal(verifySuccess.verified, true);
+  assert.equal(verifySuccess.matchedCount, 1);
+
+  const verifyFail = ext.verifyBackup(manifest, [
+    { ...files[0], md5: 'corrupted_hash' }
+  ]);
+  assert.equal(verifyFail.verified, false);
+  assert.equal(verifyFail.mismatches.length, 1);
+});
