@@ -0,0 +1,105 @@
+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi,
+  VaultrFileMetadata
+} from '../types.js';
+
+export interface MovrRule {
+  pattern: RegExp | string;
+  targetFolder: string;
+  matchField?: 'path' | 'mimeOrExt' | 'tag';
+}
+
+export interface MovrPlanItem {
+  file: VaultrFileMetadata;
+  sourcePath: string;
+  destinationPath: string;
+  rcloneCommand: string;
+}
+
+export class MovrOrganizerExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-movr-organizer',
+    name: 'Movr File & Vault Organizer',
+    version: '0.1.0',
+    description: 'Rule-based file organizer moving files into clean hierarchies and updating sidecars across local & rclone remotes.',
+    category: 'organizer',
+    author: 't3hkitty',
+    entrypoint: 'extensions/movr/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/movr',
+    enabledByDefault: true,
+    capabilities: ['rule-based-organize', 'sidecar-path-migration', 'rclone-move-plan']
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr-movr-organizer',
+      stage: 'init',
+      message: 'Movr Organizer extension initialized.'
+    });
+  }
+
+  /**
+   * Plans file moves based on taxonomy rules without executing immediately
+   */
+  public generateOrganizationPlan(files: VaultrFileMetadata[], rules: MovrRule[]): MovrPlanItem[] {
+    const plan: MovrPlanItem[] = [];
+
+    for (const file of files) {
+      for (const rule of rules) {
+        let matched = false;
+        const field = rule.matchField || 'mimeOrExt';
+
+        if (field === 'mimeOrExt') {
+          matched = typeof rule.pattern === 'string'
+            ? file.mimeOrExt.toLowerCase() === rule.pattern.toLowerCase()
+            : rule.pattern.test(file.mimeOrExt);
+        } else if (field === 'path') {
+          matched = typeof rule.pattern === 'string'
+            ? file.path.includes(rule.pattern)
+            : rule.pattern.test(file.path);
+        } else if (field === 'tag') {
+          matched = file.tags.some(t => typeof rule.pattern === 'string' ? t === rule.pattern : rule.pattern.test(t));
+        }
+
+        if (matched) {
+          const filename = file.path.split(/[\/\\]/).pop() || 'file';
+          const destinationPath = `${rule.targetFolder.replace(/\/$/, '')}/${filename}`;
+
+          if (destinationPath !== file.path) {
+            const remotePrefix = file.remote.endsWith(':') ? file.remote : `${file.remote}:`;
+            const rcloneCmd = `rclone moveto "${remotePrefix}${file.remotePath}" "${remotePrefix}${destinationPath}" --dry-run`;
+            plan.push({
+              file,
+              sourcePath: file.path,
+              destinationPath,
+              rcloneCommand: rcloneCmd
+            });
+          }
+          break; // First matching rule wins
+        }
+      }
+    }
+
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr-movr-organizer',
+      stage: 'organize',
+      message: `Generated organization plan for ${plan.length} files.`,
+      meta: { count: plan.length }
+    });
+
+    return plan;
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new MovrOrganizerExtension();
+}
