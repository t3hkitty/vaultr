+++ b/extensions/tagger/index.ts
@@ -0,0 +1,78 @@
+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi,
+  VaultrFileMetadata
+} from '../types.js';
+
+export interface TaggingRule {
+  tag: string;
+  keywords: string[];
+  extensions?: string[];
+}
+
+export class ContentTaggerExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-content-tagger',
+    name: 'Smart Content & Metadata Tagger',
+    version: '0.1.0',
+    description: 'Auto-tags files and sidecars based on file patterns, text analysis, and sidecar notes without altering files.',
+    category: 'tagger',
+    author: 't3hkitty',
+    entrypoint: 'extensions/tagger/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/tagger',
+    enabledByDefault: true,
+    capabilities: ['auto-tagging', 'sidecar-tag-sync']
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr-content-tagger',
+      stage: 'init',
+      message: 'Content Tagger extension initialized.'
+    });
+  }
+
+  /**
+   * Evaluates rules against a file's path, metadata, and optional note content
+   */
+  public evaluateTags(file: VaultrFileMetadata, noteContent = '', rules: TaggingRule[]): string[] {
+    const existingTags = new Set<string>(file.tags);
+    const textCorpus = `${file.path} ${file.mimeOrExt} ${noteContent}`.toLowerCase();
+
+    for (const rule of rules) {
+      if (rule.extensions && rule.extensions.length > 0) {
+        const matchesExt = rule.extensions.some(ext => file.path.toLowerCase().endsWith(ext.toLowerCase()));
+        if (!matchesExt) continue;
+      }
+
+      const matchesKeyword = rule.keywords.some(kw => textCorpus.includes(kw.toLowerCase()));
+      if (matchesKeyword) {
+        existingTags.add(rule.tag);
+      }
+    }
+
+    return Array.from(existingTags);
+  }
+
+  /**
+   * Applies new tags to the sidecar
+   */
+  public async applyTags(file: VaultrFileMetadata, newTags: string[]): Promise<VaultrFileMetadata> {
+    const updated: VaultrFileMetadata = {
+      ...file,
+      tags: newTags
+    };
+    await this.hostApi.saveSidecar(updated);
+    return updated;
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new ContentTaggerExtension();
+}
diff --git a/extensions/types.ts b/extensions/types.ts
new file mode 100644
