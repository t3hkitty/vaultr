+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi,
+  VaultrFileMetadata
+} from '../types.js';
+
+export class DedupeExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-md5-dedupe',
+    name: 'MD5 Deduplication & Quarantine Manager',
+    version: '0.1.0',
+    description: 'Safe MD5 checksum duplicate clustering, keeper selection, and non-destructive quarantine workflows.',
+    category: 'dedupe',
+    author: 't3hkitty',
+    entrypoint: 'extensions/dedupe/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/dedupe',
+    enabledByDefault: true,
+    capabilities: ['md5-deduplication', 'quarantine-preview', 'safe-resolution']
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr-md5-dedupe',
+      stage: 'init',
+      message: 'Dedupe extension initialized.'
+    });
+  }
+
+  public groupDuplicates(files: VaultrFileMetadata[]): Map<string, VaultrFileMetadata[]> {
+    const map = new Map<string, VaultrFileMetadata[]>();
+    for (const f of files) {
+      if (!f.md5) continue;
+      const group = map.get(f.md5) || [];
+      group.push(f);
+      map.set(f.md5, group);
+    }
+    for (const [key, list] of map.entries()) {
+      if (list.length <= 1) {
+        map.delete(key);
+      }
+    }
+    return map;
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new DedupeExtension();
+}
