+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi,
+  VaultrFileMetadata
+} from '../types.js';
+
+export interface KittlibrBookMetadata {
+  isbn?: string;
+  title: string;
+  author: string;
+  series?: string;
+  publisher?: string;
+  year?: number;
+  rating?: number;
+  description?: string;
+  tags?: string[];
+}
+
+export class KittlibrMetadataExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-kittlibr-metadata',
+    name: 'Kittlibr Metadata & Sidecar Bridge',
+    version: '0.1.0',
+    description: 'Bridges Kittlibr rich book/document YAML metadata directly into AnyMD sidecars with symlink and cross-index support.',
+    category: 'metadata',
+    author: 't3hkitty',
+    entrypoint: 'extensions/kittlibr/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/kittlibr',
+    enabledByDefault: true,
+    capabilities: ['kittlibr-schema-sync', 'yaml-sidecar-enrichment', 'symlink-sidecar']
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr-kittlibr-metadata',
+      stage: 'init',
+      message: 'Kittlibr Metadata Bridge extension initialized.'
+    });
+  }
+
+  /**
+   * Enriches standard VaultrFileMetadata with Kittlibr book schema fields
+   */
+  public enrichMetadata(
+    file: VaultrFileMetadata,
+    kittlibrInfo: KittlibrBookMetadata
+  ): VaultrFileMetadata {
+    const enrichedCustom = {
+      ...(file.custom || {}),
+      kittlibr: {
+        isbn: kittlibrInfo.isbn,
+        series: kittlibrInfo.series,
+        publisher: kittlibrInfo.publisher,
+        year: kittlibrInfo.year,
+        rating: kittlibrInfo.rating,
+        synopsis: kittlibrInfo.description
+      }
+    };
+
+    const combinedTags = Array.from(new Set([...file.tags, ...(kittlibrInfo.tags || [])]));
+
+    return {
+      ...file,
+      tags: combinedTags,
+      custom: enrichedCustom
+    };
+  }
+
+  /**
+   * Builds symlink command linking a centralized Kittlibr metadata sidecar to a local vault path
+   */
+  public buildSymlinkCommand(targetSidecarPath: string, linkLocation: string): string {
+    return `ln -s "${targetSidecarPath}" "${linkLocation}"`;
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new KittlibrMetadataExtension();
+}
