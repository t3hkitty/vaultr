@@ -0,0 +1,94 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { UnpackrExtension } from '../dist/unpackr/index.js';
+
+function createMockHost() {
+  const logs = [];
+  return {
+    log: (entry) => logs.push(entry),
+    getFiles: () => [],
+    getFileByPath: () => undefined,
+    saveSidecar: async () => {},
+    executeRclonePreview: () => {},
+    logs
+  };
+}
+
+test('UnpackrExtension builds inspect command via 7z l -slt', () => {
+  const host = createMockHost();
+  const unpackr = new UnpackrExtension();
+  unpackr.init(host);
+
+  const cmd = unpackr.buildInspectCommand('/torbox/giant_bundle.zip');
+  assert.equal(cmd.command, '7z');
+  assert.equal(cmd.fullCommandLine, '7z l -slt "/torbox/giant_bundle.zip"');
+});
+
+test('UnpackrExtension filters wanted files by pattern or specific path', () => {
+  const host = createMockHost();
+  const unpackr = new UnpackrExtension();
+  unpackr.init(host);
+
+  const items = [
+    { path: 'bundle/extras/bonus.exe', size: 100000000 },
+    { path: 'bundle/books/novel.epub', size: 2500000 },
+    { path: 'bundle/audio/track01.mp3', size: 8000000 },
+    { path: 'bundle/junk.tmp', size: 500000000 }
+  ];
+
+  const epubsOnly = unpackr.filterWantedItems(items, ['*.epub']);
+  assert.equal(epubsOnly.length, 1);
+  assert.equal(epubsOnly[0].path, 'bundle/books/novel.epub');
+
+  const mediaAndBooks = unpackr.filterWantedItems(items, ['*.epub', '*.mp3']);
+  assert.equal(mediaAndBooks.length, 2);
+});
+
+test('UnpackrExtension checkPreFlightHeadroom blocks extraction exceeding budget or disk capacity', () => {
+  const host = createMockHost();
+  const unpackr = new UnpackrExtension();
+  unpackr.init(host);
+
+  const giantItems = [
+    { path: 'massive_video.mkv', size: 16 * 1024 * 1024 * 1024 } // 16 GB
+  ];
+
+  // Budget is 5 GB
+  const checkBudgetFail = unpackr.checkPreFlightHeadroom(giantItems, 5 * 1024 * 1024 * 1024);
+  assert.equal(checkBudgetFail.allowed, false);
+  assert.ok(checkBudgetFail.reason?.includes('exceeds safety budget'));
+
+  // Allowed under 20 GB budget with 50 GB free
+  const checkPass = unpackr.checkPreFlightHeadroom(giantItems, 20 * 1024 * 1024 * 1024, 50 * 1024 * 1024 * 1024);
+  assert.equal(checkPass.allowed, true);
+});
+
+test('UnpackrExtension builds selective extraction plan into scratch directory with auto-clean hook', () => {
+  const host = createMockHost();
+  const unpackr = new UnpackrExtension();
+  unpackr.init(host);
+
+  const items = [
+    { path: 'Calibre/Dune.epub', size: 2000000 },
+    { path: 'Extras/poster.png', size: 5000000 }
+  ];
+
+  const plan = unpackr.buildSelectiveExtractionPlan(
+    {
+      archivePath: '/torbox/archive.7z',
+      scratchOutputDir: '/tmp/unpackr_scratch_123',
+      includePatterns: ['*.epub'],
+      maxUnpackBudgetBytes: 10 * 1024 * 1024 * 1024,
+      autoCleanScratchAfterMove: true
+    },
+    items
+  );
+
+  assert.equal(plan.command, '7z');
+  assert.equal(plan.targetFilesCount, 1);
+  assert.equal(plan.autoCleanScratchAfterMove, true);
+  assert.ok(plan.fullCommandLine.includes('7z x /torbox/archive.7z -o/tmp/unpackr_scratch_123 -y -ir!*.epub'));
+
+  const cleanupCmd = unpackr.buildScratchCleanupCommand(plan.scratchOutputDir);
+  assert.equal(cleanupCmd, 'rm -rf "/tmp/unpackr_scratch_123"');
+});
