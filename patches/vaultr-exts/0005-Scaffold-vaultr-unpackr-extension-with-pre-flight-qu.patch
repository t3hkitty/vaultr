+export interface ArchiveItemInfo {
+  path: string;
+  size: number;
+  packedSize?: number;
+  crc?: string;
+  modified?: string;
+}
+
+export interface UnpackrInspectionResult {
+  archivePath: string;
+  totalEntries: number;
+  totalUncompressedBytes: number;
+  items: ArchiveItemInfo[];
+}
+
+export interface UnpackrPreFlightCheck {
+  allowed: boolean;
+  totalUncompressedBytes: number;
+  maxBudgetBytes: number;
+  estimatedRemainingBytes: number;
+  reason?: string;
+}
+
+export interface SelectiveExtractionSpec {
+  archivePath: string;
+  scratchOutputDir: string;
+  includePatterns?: string[]; // e.g. ['*.epub', '*.pdf', '*.mp3', '*.mp4']
+  specificFilePaths?: string[]; // e.g. ['Calibre/Book.epub']
+  maxUnpackBudgetBytes?: number;
+  availableFreeBytes?: number;
+  autoCleanScratchAfterMove?: boolean;
+}
+
+export interface UnpackrExecutionPlan {
+  command: string;
+  args: string[];
+  fullCommandLine: string;
+  scratchOutputDir: string;
+  autoCleanScratchAfterMove: boolean;
+  targetFilesCount: number;
+  estimatedBytes: number;
+}
