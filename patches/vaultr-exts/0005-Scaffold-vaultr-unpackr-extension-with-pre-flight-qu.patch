+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi
+} from '../types.js';
+import type {
+  ArchiveItemInfo,
+  UnpackrInspectionResult,
+  UnpackrPreFlightCheck,
+  SelectiveExtractionSpec,
+  UnpackrExecutionPlan
+} from './types.js';
+
+export class UnpackrExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-unpackr',
+    name: 'Unpackr Selective Archive Extractor & Quota Guard',
+    version: '0.1.0',
+    description: 'Inspects and selectively unpacks archives (.zip, .7z, .rar, .tar) with pre-flight quota guards, targeted file filters, and auto-clean scratch directories to avoid filling disks.',
+    category: 'storage',
+    author: 't3hkitty',
+    entrypoint: 'extensions/unpackr/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/unpackr',
+    enabledByDefault: true,
+    capabilities: [
+      'inspect-before-extract',
+      'selective-pattern-extraction',
+      'preflight-quota-guard',
+      'auto-clean-scratch'
+    ]
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+  private defaultMaxBudgetBytes = 5 * 1024 * 1024 * 1024; // 5 GB default safety budget
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr:unpackr',
+      stage: 'init',
+      message: 'Unpackr extension initialized with pre-flight quota guards and selective extraction.'
+    });
+  }
+
+  /**
+   * Builds 7z listing command to inspect archive contents before any extraction
+   */
+  public buildInspectCommand(archivePath: string): { command: string; args: string[]; fullCommandLine: string } {
+    const args = ['l', '-slt', archivePath];
+    return {
+      command: '7z',
+      args,
+      fullCommandLine: `7z l -slt "${archivePath}"`
+    };
+  }
+
+  /**
+   * Pre-flight size and disk headroom check before extraction
+   */
+  public checkPreFlightHeadroom(
+    targetItems: ArchiveItemInfo[],
+    maxBudgetBytes?: number,
+    availableFreeBytes?: number
+  ): UnpackrPreFlightCheck {
+    const budget = maxBudgetBytes || this.defaultMaxBudgetBytes;
+    const totalBytes = targetItems.reduce((acc, it) => acc + (it.size || 0), 0);
+
+    if (totalBytes > budget) {
+      const msg = `Extraction size (${(totalBytes / 1e9).toFixed(2)} GB) exceeds safety budget (${(budget / 1e9).toFixed(2)} GB). Aborting full extraction to protect disk.`;
+      this.hostApi.log({
+        timestamp: new Date().toISOString(),
+        level: 'warn',
+        source: 'vaultr:unpackr',
+        stage: 'preflight',
+        message: msg,
+        meta: { totalBytes, budget }
+      });
+      return {
+        allowed: false,
+        totalUncompressedBytes: totalBytes,
+        maxBudgetBytes: budget,
+        estimatedRemainingBytes: (availableFreeBytes ?? budget) - totalBytes,
+        reason: msg
+      };
+    }
+
+    if (availableFreeBytes !== undefined && totalBytes > availableFreeBytes * 0.9) {
+      const msg = `Extraction size (${(totalBytes / 1e9).toFixed(2)} GB) consumes over 90% of available free disk space (${(availableFreeBytes / 1e9).toFixed(2)} GB).`;
+      this.hostApi.log({
+        timestamp: new Date().toISOString(),
+        level: 'warn',
+        source: 'vaultr:unpackr',
+        stage: 'preflight',
+        message: msg,
+        meta: { totalBytes, availableFreeBytes }
+      });
+      return {
+        allowed: false,
+        totalUncompressedBytes: totalBytes,
+        maxBudgetBytes: budget,
+        estimatedRemainingBytes: availableFreeBytes - totalBytes,
+        reason: msg
+      };
+    }
+
+    return {
+      allowed: true,
+      totalUncompressedBytes: totalBytes,
+      maxBudgetBytes: budget,
+      estimatedRemainingBytes: (availableFreeBytes ?? budget) - totalBytes
+    };
+  }
+
+  /**
+   * Filters inspected items to only matching extensions or specific file paths
+   */
+  public filterWantedItems(
+    items: ArchiveItemInfo[],
+    patterns: string[] = ['*.epub', '*.pdf', '*.mp3', '*.mp4', '*.flac', '*.md'],
+    specificPaths?: string[]
+  ): ArchiveItemInfo[] {
+    if (specificPaths && specificPaths.length > 0) {
+      const set = new Set(specificPaths.map(p => p.toLowerCase()));
+      return items.filter(it => set.has(it.path.toLowerCase()));
+    }
+
+    const regexes = patterns.map(pat => {
+      const escaped = pat.replace(/\./g, '\\.').replace(/\*/g, '.*');
+      return new RegExp(`^${escaped}$`, 'i');
+    });
+
+    return items.filter(it => {
+      const filename = it.path.split(/[\/\\]/).pop() || it.path;
+      return regexes.some(re => re.test(filename) || re.test(it.path));
+    });
+  }
+
+  /**
+   * Builds selective 7z extraction command into dedicated scratch directory
+   */
+  public buildSelectiveExtractionPlan(spec: SelectiveExtractionSpec, inspectedItems: ArchiveItemInfo[]): UnpackrExecutionPlan {
+    const wanted = this.filterWantedItems(inspectedItems, spec.includePatterns, spec.specificFilePaths);
+    const preflight = this.checkPreFlightHeadroom(wanted, spec.maxUnpackBudgetBytes, spec.availableFreeBytes);
+
+    if (!preflight.allowed) {
+      throw new Error(`Pre-flight check failed: ${preflight.reason}`);
+    }
+
+    const args = ['x', spec.archivePath, `-o${spec.scratchOutputDir}`, '-y'];
+
+    if (spec.specificFilePaths && spec.specificFilePaths.length > 0) {
+      for (const p of spec.specificFilePaths) {
+        args.push(p);
+      }
+    } else if (spec.includePatterns && spec.includePatterns.length > 0) {
+      for (const pat of spec.includePatterns) {
+        args.push(`-ir!${pat}`);
+      }
+    }
+
+    const fullCommandLine = `7z ${args.map(a => (a.includes(' ') ? `"${a}"` : a)).join(' ')}`;
+
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr:unpackr',
+      stage: 'plan',
+      message: `Built selective extraction plan for ${wanted.length} files (${(preflight.totalUncompressedBytes / 1e6).toFixed(1)} MB) into scratch dir ${spec.scratchOutputDir}.`,
+      meta: { targetCount: wanted.length, bytes: preflight.totalUncompressedBytes }
+    });
+
+    return {
+      command: '7z',
+      args,
+      fullCommandLine,
+      scratchOutputDir: spec.scratchOutputDir,
+      autoCleanScratchAfterMove: spec.autoCleanScratchAfterMove ?? true,
+      targetFilesCount: wanted.length,
+      estimatedBytes: preflight.totalUncompressedBytes
+    };
+  }
+
+  /**
+   * Generates clean-up command for the scratch staging directory
+   */
+  public buildScratchCleanupCommand(scratchOutputDir: string): string {
+    return `rm -rf "${scratchOutputDir}"`;
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new UnpackrExtension();
+}
