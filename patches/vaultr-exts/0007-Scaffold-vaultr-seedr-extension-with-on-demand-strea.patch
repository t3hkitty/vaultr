+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi,
+  VaultrFileMetadata
+} from '../types.js';
+import type {
+  DebridProvider,
+  StreamResolutionOptions,
+  ResolvedStreamInfo,
+  VlcPlaylistItem
+} from './types.js';
+
+export const TORBOX_TESTED_NOTICE = 'Notice: only TorBox tested due to tool access. Seedr provider integration remains experimental/untested.';
+
+export class SeedrVlcExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-seedr',
+    name: 'Seedr & Remote Debrid VLC Stream & M3U8 Bridge',
+    version: '0.1.0',
+    description: 'Resolves on-demand fresh stream/download URLs for VLC playback and .m3u8 dynamic shelves. Note: Only TorBox tested due to tool access.',
+    category: 'storage',
+    author: 't3hkitty',
+    entrypoint: 'extensions/seedr/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/seedr',
+    enabledByDefault: true,
+    capabilities: [
+      'on-demand-stream-resolve',
+      'vlc-m3u8-extvlcopt',
+      'vlc-command-hand-off',
+      'expired-link-refresh',
+      'torbox-tested-provider'
+    ]
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+  private torboxApiKey?: string;
+  private seedrToken?: string;
+
+  constructor(options: { torboxApiKey?: string; seedrToken?: string } = {}) {
+    this.torboxApiKey = options.torboxApiKey;
+    this.seedrToken = options.seedrToken;
+  }
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.logRedacted('init', `Seedr/Debrid VLC Bridge initialized. ${TORBOX_TESTED_NOTICE}`);
+  }
+
+  public setTorboxKey(key: string): void {
+    this.torboxApiKey = key;
+  }
+
+  public setSeedrToken(token: string): void {
+    this.seedrToken = token;
+  }
+
+  /**
+   * Redacts sensitive tokens before logging to AnyMD host
+   */
+  public logRedacted(stage: string, message: string, meta: Record<string, unknown> = {}): void {
+    const sanitizedMeta = { ...meta };
+    if (sanitizedMeta.token || sanitizedMeta.key || sanitizedMeta.apiKey) {
+      delete sanitizedMeta.token;
+      delete sanitizedMeta.key;
+      delete sanitizedMeta.apiKey;
+      sanitizedMeta.tokenRedacted = true;
+    }
+
+    let sanitizedMsg = message;
+    if (this.torboxApiKey) {
+      sanitizedMsg = sanitizedMsg.replace(new RegExp(this.torboxApiKey, 'g'), '[REDACTED_TORBOX_KEY]');
+    }
+    if (this.seedrToken) {
+      sanitizedMsg = sanitizedMsg.replace(new RegExp(this.seedrToken, 'g'), '[REDACTED_SEEDR_TOKEN]');
+    }
+
+    this.hostApi?.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr:seedr:vlc',
+      stage,
+      message: sanitizedMsg,
+      meta: {
+        ...sanitizedMeta,
+        providerNotice: TORBOX_TESTED_NOTICE
+      }
+    });
+  }
+
+  /**
+   * Resolves a fresh stream URL on-demand right when "Play in VLC" is triggered
+   */
+  public resolveFreshStreamUrl(
+    item: VaultrFileMetadata,
+    options: StreamResolutionOptions = {}
+  ): ResolvedStreamInfo {
+    const provider: DebridProvider = options.provider || (item.custom?.backend === 'torbox' ? 'torbox' : 'torbox');
+
+    if (provider === 'torbox') {
+      const torboxId = item.custom?.torbox_id || '0';
+      const fileId = item.custom?.file_id || '0';
+      const apiKey = this.torboxApiKey || 'LOCAL_KEY_OR_ENV';
+
+      // Build TorBox requestdl URL
+      // TorBox download links provide a 3-hour window to start, and near-unlimited once initiated
+      const streamUrl = `https://api.torbox.app/v1/api/torrents/requestdl?token=${apiKey}&torrent_id=${torboxId}&file_id=${fileId}&zip=false`;
+
+      this.logRedacted('resolve', `Resolved fresh TorBox stream for item [${item.path}]`, {
+        torboxId,
+        fileId,
+        provider: 'torbox'
+      });
+
+      return {
+        streamUrl,
+        provider: 'torbox',
+        resolvedAt: new Date().toISOString(),
+        expiresInSeconds: 3 * 60 * 60, // 3 hours window to start
+        testedStatus: 'verified (TorBox)',
+        isDirectStreamable: true
+      };
+    } else {
+      // Seedr experimental branch
+      const seedrFileId = item.custom?.seedr_file_id || '0';
+      const streamUrl = `https://www.seedr.cc/download/file/${seedrFileId}`;
+
+      this.logRedacted('resolve', `Resolved experimental Seedr URL for item [${item.path}]. Note: only TorBox tested due to tool access.`, {
+        seedrFileId,
+        provider: 'seedr_cc'
+      });
+
+      return {
+        streamUrl,
+        provider: 'seedr_cc',
+        resolvedAt: new Date().toISOString(),
+        testedStatus: 'untested (Seedr - only TorBox tested due to tool access)',
+        isDirectStreamable: true
+      };
+    }
+  }
+
+  /**
+   * Generates extended M3U8 string with #EXTVLCOPT: options for VLC multi-track streaming
+   */
+  public generateVlcM3u8(playlistName: string, items: VlcPlaylistItem[]): string {
+    const lines = [
+      '#EXTM3U',
+      `#PLAYLIST:${playlistName}`,
+      `#COMMENT:${TORBOX_TESTED_NOTICE}`
+    ];
+
+    for (const item of items) {
+      const dur = item.durationSeconds ?? -1;
+      lines.push(`#EXTINF:${dur},${item.title}`);
+
+      // Add VLC-specific options (caching, user-agent, etc.)
+      const vlcOpts = item.vlcOptions || [':network-caching=3000'];
+      for (const opt of vlcOpts) {
+        lines.push(`#EXTVLCOPT${opt}`);
+      }
+
+      lines.push(item.streamUrl);
+    }
+
+    return lines.join('\n');
+  }
+
+  /**
+   * Builds the CLI execution command to launch VLC with stream URL or playlist
+   */
+  public buildVlcLaunchCommand(targetUrlOrPlaylistPath: string): { command: string; args: string[]; fullCommandLine: string } {
+    // Detect OS: vlc on Linux/macOS, "vlc.exe" on Windows
+    const command = 'vlc';
+    const args = ['--network-caching=3000', targetUrlOrPlaylistPath];
+    const fullCommandLine = `vlc --network-caching=3000 "${targetUrlOrPlaylistPath}"`;
+
+    this.logRedacted('vlc-launch', `Launching VLC with target: ${targetUrlOrPlaylistPath}`);
+
+    return {
+      command,
+      args,
+      fullCommandLine
+    };
+  }
+
+  /**
+   * Determines fallback action if link expires or direct streaming fails
+   */
+  public determineStreamFallback(
+    item: VaultrFileMetadata,
+    errorOrStatus?: string
+  ): { fallbackAction: 'refresh_link' | 'unpackr_handoff' | 'rclone_pull'; description: string } {
+    const isArchive = ['zip', 'rar', '7z', 'tar'].some(ext => item.path.toLowerCase().endsWith(ext));
+
+    if (isArchive) {
+      return {
+        fallbackAction: 'unpackr_handoff',
+        description: 'Item is an archive bundle. Handing off to unpackr for selective file extraction.'
+      };
+    }
+
+    if (errorOrStatus === '403' || errorOrStatus === '410' || errorOrStatus === 'expired') {
+      return {
+        fallbackAction: 'refresh_link',
+        description: 'Stream link has expired. Requesting a fresh link via API.'
+      };
+    }
+
+    return {
+      fallbackAction: 'rclone_pull',
+      description: 'Single-file pull via rclone (tbox:) on demand.'
+    };
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new SeedrVlcExtension();
+}
