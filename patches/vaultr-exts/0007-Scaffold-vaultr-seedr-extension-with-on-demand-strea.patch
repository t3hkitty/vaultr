+export type DebridProvider = 'torbox' | 'seedr_cc';
+
+export interface StreamResolutionOptions {
+  provider?: DebridProvider;
+  forceFresh?: boolean;
+  userAgent?: string;
+}
+
+export interface ResolvedStreamInfo {
+  streamUrl: string;
+  provider: DebridProvider;
+  resolvedAt: string;
+  expiresInSeconds?: number;
+  testedStatus: string; // e.g. "verified (TorBox)" | "untested (Seedr - only TorBox tested due to tool access)"
+  isDirectStreamable: boolean;
+}
+
+export interface VlcPlaylistItem {
+  title: string;
+  streamUrl: string;
+  durationSeconds?: number;
+  vlcOptions?: string[]; // e.g. [":network-caching=3000", ":http-user-agent=VaultrVlcBridge"]
+}
