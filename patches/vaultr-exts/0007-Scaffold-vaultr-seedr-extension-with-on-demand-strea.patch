diff --git a/tests/seedr.test.mjs b/tests/seedr.test.mjs
new file mode 100644
index 0000000..49d4f77
--- /dev/null
+++ b/tests/seedr.test.mjs
@@ -0,0 +1,134 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { SeedrVlcExtension, TORBOX_TESTED_NOTICE } from '../dist/seedr/index.js';
+
+function createMockHost() {
+  const logs = [];
+  return {
+    log: (entry) => logs.push(entry),
+    getFiles: () => [],
+    getFileByPath: () => undefined,
+    saveSidecar: async () => {},
+    executeRclonePreview: () => {},
+    logs
+  };
+}
+
+test('SeedrVlcExtension logs explicit TorBox-only testing notice on init and redacts tokens', () => {
+  const host = createMockHost();
+  const ext = new SeedrVlcExtension({
+    torboxApiKey: 'TORBOX_SECRET_9999',
+    seedrToken: 'SEEDR_SECRET_7777'
+  });
+  ext.init(host);
+
+  assert.equal(host.logs.length, 1);
+  const initLog = host.logs[0];
+  assert.equal(initLog.source, 'vaultr:seedr:vlc');
+  assert.ok(initLog.message.includes(TORBOX_TESTED_NOTICE));
+  assert.ok(initLog.meta.providerNotice.includes('only TorBox tested due to tool access'));
+
+  ext.logRedacted('stream', 'Playing with token TORBOX_SECRET_9999 and key SEEDR_SECRET_7777', {
+    token: 'TORBOX_SECRET_9999'
+  });
+
+  const streamLog = host.logs[1];
+  assert.ok(!streamLog.message.includes('TORBOX_SECRET_9999'));
+  assert.ok(streamLog.message.includes('[REDACTED_TORBOX_KEY]'));
+  assert.ok(streamLog.message.includes('[REDACTED_SEEDR_TOKEN]'));
+  assert.equal(streamLog.meta.token, undefined);
+  assert.equal(streamLog.meta.tokenRedacted, true);
+});
+
+test('SeedrVlcExtension resolves fresh on-demand stream URL for TorBox with 3h window and verified status', () => {
+  const host = createMockHost();
+  const ext = new SeedrVlcExtension({
+    torboxApiKey: 'test_key'
+  });
+  ext.init(host);
+
+  const mediaItem = {
+    path: 'tbox:/Movies/Inception.mp4',
+    remote: 'tbox:',
+    remotePath: 'Movies/Inception.mp4',
+    md5: 'hash_inc',
+    size: 2500000000,
+    mtime: '2026-11-20T10:00:00Z',
+    mimeOrExt: 'mp4',
+    tags: ['movie'],
+    custom: {
+      backend: 'torbox',
+      torbox_id: 501,
+      file_id: 12
+    }
+  };
+
+  const resolved = ext.resolveFreshStreamUrl(mediaItem);
+  assert.equal(resolved.provider, 'torbox');
+  assert.ok(resolved.streamUrl.includes('torrent_id=501'));
+  assert.ok(resolved.streamUrl.includes('file_id=12'));
+  assert.equal(resolved.expiresInSeconds, 10800); // 3 hours window
+  assert.equal(resolved.testedStatus, 'verified (TorBox)');
+  assert.equal(resolved.isDirectStreamable, true);
+});
+
+test('SeedrVlcExtension generates .m3u8 playlist with #EXTVLCOPT and provider testing notice', () => {
+  const host = createMockHost();
+  const ext = new SeedrVlcExtension();
+  ext.init(host);
+
+  const items = [
+    {
+      title: 'Episode 1',
+      streamUrl: 'https://api.torbox.app/v1/api/torrents/requestdl?token=REDACTED&torrent_id=1&file_id=1&zip=false',
+      durationSeconds: 3600,
+      vlcOptions: [':network-caching=5000', ':http-user-agent=Vaultr']
+    }
+  ];
+
+  const m3u8 = ext.generateVlcM3u8('My Season Stream', items);
+  assert.ok(m3u8.startsWith('#EXTM3U\n#PLAYLIST:My Season Stream'));
+  assert.ok(m3u8.includes('#COMMENT:Notice: only TorBox tested due to tool access.'));
+  assert.ok(m3u8.includes('#EXTINF:3600,Episode 1'));
+  assert.ok(m3u8.includes('#EXTVLCOPT:network-caching=5000'));
+  assert.ok(m3u8.includes('#EXTVLCOPT:http-user-agent=Vaultr'));
+  assert.ok(m3u8.includes('https://api.torbox.app/v1/api/torrents/requestdl'));
+});
+
+test('SeedrVlcExtension builds CLI launch command and detects archive fallback', () => {
+  const host = createMockHost();
+  const ext = new SeedrVlcExtension();
+  ext.init(host);
+
+  const launch = ext.buildVlcLaunchCommand('https://stream.torbox.app/file.mp4');
+  assert.equal(launch.command, 'vlc');
+  assert.equal(launch.fullCommandLine, 'vlc --network-caching=3000 "https://stream.torbox.app/file.mp4"');
+
+  // Archive fallback
+  const archiveItem = {
+    path: 'tbox:/bundle.rar',
+    remote: 'tbox:',
+    remotePath: 'bundle.rar',
+    md5: 'hash_rar',
+    size: 5000000000,
+    mtime: '2026-11-20',
+    mimeOrExt: 'rar',
+    tags: []
+  };
+  const fallback = ext.determineStreamFallback(archiveItem);
+  assert.equal(fallback.fallbackAction, 'unpackr_handoff');
+
+  // Expired link fallback
+  const singleFile = {
+    path: 'tbox:/audio.mp3',
+    remote: 'tbox:',
+    remotePath: 'audio.mp3',
+    md5: 'hash_mp3',
+    size: 5000000,
+    mtime: '2026-11-20',
+    mimeOrExt: 'mp3',
+    tags: []
+  };
+  const expiredFallback = ext.determineStreamFallback(singleFile, 'expired');
+  assert.equal(expiredFallback.fallbackAction, 'refresh_link');
+});
