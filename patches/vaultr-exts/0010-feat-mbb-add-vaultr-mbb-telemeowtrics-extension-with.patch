@@ -0,0 +1,199 @@
+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi
+} from '../types.js';
+
+export interface MbbScopePreset {
+  id: string;
+  name: string;
+  scopes: string[];
+  description: string;
+  isSensitive: boolean;
+}
+
+export interface MbbTelemetryPayload {
+  timestamp: string;
+  source: 'google-fit' | 'macrodroid' | 'tasker' | 'manual' | 'telemeowtrics';
+  category: 'fitness' | 'somatic' | 'location' | 'contacts' | 'system';
+  metrics: Record<string, any>;
+  notes?: string;
+  tags?: string[];
+}
+
+export interface MbbScopeStatus {
+  presetId: string;
+  name: string;
+  authorized: boolean;
+  grantedScopes: string[];
+  missingScopes: string[];
+  warningMessage?: string;
+}
+
+export const MBB_AVAILABLE_PRESETS: Record<string, MbbScopePreset> = {
+  base: {
+    id: 'base',
+    name: 'Base Identity',
+    scopes: ['openid', 'email', 'profile'],
+    description: 'Basic account identification and profile metadata.',
+    isSensitive: false
+  },
+  drive_vault: {
+    id: 'drive_vault',
+    name: 'Drive & Vault Staging',
+    scopes: [
+      'https://www.googleapis.com/auth/drive.file',
+      'https://www.googleapis.com/auth/drive.appdata'
+    ],
+    description: 'Read and write AnyMD notes, sidecars, and vault staging archives in Google Drive.',
+    isSensitive: false
+  },
+  mbb_fitness: {
+    id: 'mbb_fitness',
+    name: 'Fitness & Somatics (Google Fit / Health Connect)',
+    scopes: [
+      'https://www.googleapis.com/auth/fitness.activity.read',
+      'https://www.googleapis.com/auth/fitness.body.read',
+      'https://www.googleapis.com/auth/fitness.location.read'
+    ],
+    description: 'Daily steps, heart rate, sleep duration, and active energy for somatic telemetry logs.',
+    isSensitive: true
+  },
+  mbb_location: {
+    id: 'mbb_location',
+    name: 'Timeline & Location Logs',
+    scopes: [
+      'https://www.googleapis.com/auth/fitness.location.read'
+    ],
+    description: 'Geofence transitions and timeline coordinates feeding Telemeowtrics daily logs.',
+    isSensitive: true
+  },
+  mbb_contacts: {
+    id: 'mbb_contacts',
+    name: 'Contacts & People Graph',
+    scopes: [
+      'https://www.googleapis.com/auth/contacts.readonly'
+    ],
+    description: 'CardDAV / Google Contacts context for relationship and communication CRM notes.',
+    isSensitive: true
+  }
+};
+
+export class MbbTelemetryExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-mbb-telemeowtrics',
+    name: 'MBB Somatic & Telemeowtrics Telemetry Bridge',
+    version: '0.1.0',
+    description: 'Ingests somatic, fitness, location, and contacts telemetry into AnyMD YAML/Markdown notes and meow-vault without external webhooks.',
+    category: 'metadata',
+    author: 't3hkitty',
+    entrypoint: 'extensions/mbb/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr/tree/main/extensions/mbb',
+    enabledByDefault: true,
+    capabilities: [
+      'somatic-telemetry-ingest',
+      'scope-status-audit',
+      'markdown-vault-logger',
+      'offline-graceful-degrade'
+    ]
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+  private authorizedScopes: Set<string> = new Set();
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr:mbb',
+      stage: 'init',
+      message: 'MBB Telemetry & Somatic extension initialized with modular scope presets.'
+    });
+  }
+
+  /**
+   * Sets granted scopes from active token bundle
+   */
+  public setGrantedScopes(scopes: string[] | string): void {
+    const list = Array.isArray(scopes) ? scopes : scopes.split(' ').filter(Boolean);
+    this.authorizedScopes = new Set(list);
+  }
+
+  /**
+   * Checks authorization status across all MBB presets, reporting missing scopes and warnings.
+   */
+  public evaluateScopeStatus(): Record<string, MbbScopeStatus> {
+    const report: Record<string, MbbScopeStatus> = {};
+
+    for (const [key, preset] of Object.entries(MBB_AVAILABLE_PRESETS)) {
+      const granted = preset.scopes.filter(s => this.authorizedScopes.has(s));
+      const missing = preset.scopes.filter(s => !this.authorizedScopes.has(s));
+      const isAuthorized = missing.length === 0;
+
+      let warningMessage: string | undefined;
+      if (!isAuthorized) {
+        warningMessage = preset.isSensitive
+          ? `Module "${preset.name}" is pending consent. For personal/test user setup, authorize via Desktop loopback and click "Advanced -> Go to AnyMD (unsafe)" if unverified.`
+          : `Module "${preset.name}" is not authorized. Missing: ${missing.join(', ')}`;
+      }
+
+      report[key] = {
+        presetId: preset.id,
+        name: preset.name,
+        authorized: isAuthorized,
+        grantedScopes: granted,
+        missingScopes: missing,
+        warningMessage
+      };
+    }
+
+    return report;
+  }
+
+  /**
+   * Transforms raw telemetry (e.g. from MacroDroid / Tasker / Google Fit) into AnyMD Markdown format
+   */
+  public formatTelemetryToMarkdown(payload: MbbTelemetryPayload): { frontmatter: Record<string, any>; body: string } {
+    const nowIso = payload.timestamp || new Date().toISOString();
+    const dateStr = nowIso.split('T')[0];
+
+    const frontmatter: Record<string, any> = {
+      id: `mbb-${dateStr}-${payload.category}`,
+      type: `telemetry/${payload.category}`,
+      source: payload.source,
+      recorded_at: nowIso,
+      vault_zone: 'meow-vault/telemetry',
+      tags: ['mbb', 'telemeowtrics', payload.category, ...(payload.tags || [])],
+      metrics: payload.metrics
+    };
+
+    const bodyLines: string[] = [
+      `# MBB Telemetry: ${payload.category.toUpperCase()} (${dateStr})`,
+      ``,
+      `* **Source:** \`${payload.source}\``,
+      `* **Timestamp:** \`${nowIso}\``,
+      ``,
+      `## Recorded Metrics`,
+      `| Metric | Value |`,
+      `| :--- | :--- |`
+    ];
+
+    for (const [k, v] of Object.entries(payload.metrics)) {
+      bodyLines.push(`| **${k}** | \`${typeof v === 'object' ? JSON.stringify(v) : v}\` |`);
+    }
+
+    if (payload.notes) {
+      bodyLines.push(``, `## Notes & Observations`, payload.notes);
+    }
+
+    return {
+      frontmatter,
+      body: bodyLines.join('\n')
+    };
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new MbbTelemetryExtension();
+}
