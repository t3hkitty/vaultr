diff --git a/tests/mbb.test.mjs b/tests/mbb.test.mjs
new file mode 100644
index 0000000..1f1c18f
--- /dev/null
+++ b/tests/mbb.test.mjs
@@ -0,0 +1,70 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { MbbTelemetryExtension, MBB_AVAILABLE_PRESETS } from '../dist/mbb/index.js';
+
+function createMockHost() {
+  const logs = [];
+  return {
+    log: (entry) => logs.push(entry),
+    getFiles: () => [],
+    getFileByPath: () => undefined,
+    saveSidecar: async () => {},
+    executeRclonePreview: () => {},
+    logs
+  };
+}
+
+test('MbbTelemetryExtension initializes with modular scope presets', () => {
+  const host = createMockHost();
+  const mbb = new MbbTelemetryExtension();
+  mbb.init(host);
+
+  assert.ok(MBB_AVAILABLE_PRESETS.mbb_fitness);
+  assert.ok(MBB_AVAILABLE_PRESETS.mbb_location);
+  assert.ok(MBB_AVAILABLE_PRESETS.mbb_contacts);
+  assert.equal(MBB_AVAILABLE_PRESETS.mbb_fitness.isSensitive, true);
+});
+
+test('MbbTelemetryExtension correctly identifies missing vs granted scopes and warns on sensitive unverified scopes', () => {
+  const host = createMockHost();
+  const mbb = new MbbTelemetryExtension();
+  mbb.init(host);
+
+  // User only granted base + drive
+  mbb.setGrantedScopes([
+    'openid',
+    'email',
+    'profile',
+    'https://www.googleapis.com/auth/drive.file'
+  ]);
+
+  const status = mbb.evaluateScopeStatus();
+  assert.equal(status.base.authorized, true);
+  assert.equal(status.mbb_fitness.authorized, false);
+  assert.ok(status.mbb_fitness.warningMessage.includes('Advanced -> Go to AnyMD (unsafe)'));
+  assert.equal(status.mbb_fitness.missingScopes.length, 3);
+});
+
+test('MbbTelemetryExtension formats somatic telemetry into AnyMD YAML frontmatter and Markdown body', () => {
+  const host = createMockHost();
+  const mbb = new MbbTelemetryExtension();
+  mbb.init(host);
+
+  const formatted = mbb.formatTelemetryToMarkdown({
+    timestamp: '2026-11-23T10:00:00Z',
+    source: 'macrodroid',
+    category: 'fitness',
+    metrics: {
+      steps: 8420,
+      resting_hr: 58,
+      sleep_hours: 7.5
+    },
+    notes: 'Morning walk completed along coastal path.'
+  });
+
+  assert.equal(formatted.frontmatter.id, 'mbb-2026-11-23-fitness');
+  assert.equal(formatted.frontmatter.vault_zone, 'meow-vault/telemetry');
+  assert.equal(formatted.frontmatter.metrics.steps, 8420);
+  assert.ok(formatted.body.includes('| **resting_hr** | `58` |'));
+  assert.ok(formatted.body.includes('Morning walk completed along coastal path.'));
+});
