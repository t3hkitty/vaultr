+export interface TorBoxFileItem {
+  id: number | string;
+  name: string;
+  size: number;
+  hash?: string;
+  s3_path?: string;
+  short_name?: string;
+  mimetype?: string;
+}
+
+export interface TorBoxTorrentItem {
+  id: number | string;
+  name: string;
+  size: number;
+  hash: string;
+  download_state: string; // 'completed' | 'downloading' | 'cached' | 'uploading'
+  download_finished: boolean;
+  progress: number;
+  created_at: string;
+  files: TorBoxFileItem[];
+}
+
+export interface TorBoxApiResponse<T> {
+  success: boolean;
+  error?: string;
+  detail?: string;
+  data: T;
+}
+
+export interface TorBoxClientConfig {
+  apiKey?: string;        // Bearer token (loaded from local env/config, never static UI)
+  apiBaseUrl?: string;    // Default: 'https://api.torbox.app/v1/api'
+  timeoutMs?: number;
+}
