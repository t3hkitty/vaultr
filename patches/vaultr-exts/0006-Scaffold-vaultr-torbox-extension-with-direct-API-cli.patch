@@ -0,0 +1,216 @@
+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi,
+  VaultrFileMetadata,
+  VaultrLogEntry
+} from '../types.js';
+import type {
+  TorBoxTorrentItem,
+  TorBoxFileItem,
+  TorBoxApiResponse,
+  TorBoxClientConfig
+} from './types.js';
+
+export class TorBoxExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-torbox',
+    name: 'TorBox Direct API Client & Sidecar Generator',
+    version: '0.1.0',
+    description: 'Direct HTTPS TorBox API client inspecting remote torrent items and files, generating .anymd YAML sidecars, and selectively pulling files with unpackr integration without blind archive downloads.',
+    category: 'storage',
+    author: 't3hkitty',
+    entrypoint: 'extensions/torbox/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/torbox',
+    enabledByDefault: true,
+    capabilities: [
+      'torbox-direct-api',
+      'bearer-token-redaction',
+      'sidecar-first-torbox-index',
+      'selective-torbox-download',
+      'unpackr-handoff'
+    ]
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+  private config: Required<TorBoxClientConfig>;
+
+  constructor(config: TorBoxClientConfig = {}) {
+    this.config = {
+      apiKey: config.apiKey || (typeof process !== 'undefined' ? process.env.TORBOX_API_KEY || '' : ''),
+      apiBaseUrl: config.apiBaseUrl || 'https://api.torbox.app/v1/api',
+      timeoutMs: config.timeoutMs || 15000
+    };
+  }
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+    this.logRedacted('init', 'TorBox extension initialized with direct API capabilities.');
+  }
+
+  public setApiKey(key: string): void {
+    this.config.apiKey = key;
+  }
+
+  public getApiBaseUrl(): string {
+    return this.config.apiBaseUrl;
+  }
+
+  /**
+   * Redacts sensitive bearer tokens before logging to AnyMD host
+   */
+  public logRedacted(stage: string, message: string, meta: Record<string, unknown> = {}): void {
+    const sanitizedMeta = { ...meta };
+    if (sanitizedMeta.apiKey || sanitizedMeta.token || sanitizedMeta.authorization) {
+      delete sanitizedMeta.apiKey;
+      delete sanitizedMeta.token;
+      delete sanitizedMeta.authorization;
+      sanitizedMeta.tokenRedacted = true;
+    }
+
+    const sanitizedMessage = this.config.apiKey
+      ? message.replace(new RegExp(this.config.apiKey, 'g'), '[REDACTED_TORBOX_KEY]')
+      : message;
+
+    this.hostApi?.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr:torbox',
+      stage,
+      message: sanitizedMessage,
+      meta: sanitizedMeta
+    });
+  }
+
+  /**
+   * Parses TorBox API torrent list response into normalized items
+   */
+  public parseTorrentsResponse(response: TorBoxApiResponse<TorBoxTorrentItem[]>): TorBoxTorrentItem[] {
+    if (!response || !response.success || !Array.isArray(response.data)) {
+      this.logRedacted('api-parse', `TorBox response invalid or failed: ${response?.error || 'Unknown error'}`);
+      return [];
+    }
+    return response.data;
+  }
+
+  /**
+   * Generates .anymd YAML sidecars directly from TorBox API item metadata
+   */
+  public generateTorboxSidecars(
+    torrent: TorBoxTorrentItem,
+    options: { targetShelf?: string } = {}
+  ): VaultrFileMetadata[] {
+    const sidecars: VaultrFileMetadata[] = [];
+    const files = torrent.files && torrent.files.length > 0
+      ? torrent.files
+      : [{ id: 0, name: torrent.name, size: torrent.size }];
+
+    for (const f of files) {
+      const ext = f.name.split('.').pop() || 'bin';
+      const cleanPath = `tbox:/${torrent.name}/${f.name}`;
+      const virtualFolders = ['TorBox Inbox'];
+      if (options.targetShelf) {
+        virtualFolders.push(options.targetShelf);
+      }
+
+      const meta: VaultrFileMetadata = {
+        path: cleanPath,
+        remote: 'tbox:',
+        remotePath: `${torrent.name}/${f.name}`,
+        md5: f.hash || torrent.hash || '',
+        size: f.size || 0,
+        mtime: torrent.created_at || new Date().toISOString(),
+        mimeOrExt: ext,
+        tags: ['torbox', 'remote-indexed'],
+        added_at: new Date().toISOString(),
+        ingest_source: 'torbox',
+        virtual_folders: virtualFolders,
+        sidecarPath: `${cleanPath}.anymd`,
+        custom: {
+          backend: 'torbox',
+          torbox_id: torrent.id,
+          file_id: f.id,
+          torrent_hash: torrent.hash,
+          download_state: torrent.download_state,
+          download_finished: torrent.download_finished,
+          fetch_status: 'indexed-only'
+        }
+      };
+
+      sidecars.push(meta);
+    }
+
+    this.logRedacted('sidecar-gen', `Generated ${sidecars.length} sidecars for TorBox item [${torrent.name}]`, {
+      torrentId: torrent.id,
+      fileCount: sidecars.length
+    });
+
+    return sidecars;
+  }
+
+  /**
+   * Builds single-file download stream URL / request
+   */
+  public buildDownloadRequest(
+    torrentId: number | string,
+    fileId: number | string,
+    zip = false
+  ): { url: string; headers: Record<string, string>; fullCurlPreview: string } {
+    const endpoint = `${this.config.apiBaseUrl}/torrents/requestdl`;
+    const params = new URLSearchParams({
+      token: this.config.apiKey,
+      torrent_id: String(torrentId),
+      file_id: String(fileId),
+      zip: String(zip)
+    });
+
+    const fullUrl = `${endpoint}?${params.toString()}`;
+    const sanitizedUrl = fullUrl.replace(this.config.apiKey, '[REDACTED_KEY]');
+
+    return {
+      url: fullUrl,
+      headers: {
+        Authorization: `Bearer ${this.config.apiKey}`
+      },
+      fullCurlPreview: `curl -H "Authorization: Bearer [REDACTED_KEY]" "${sanitizedUrl}"`
+    };
+  }
+
+  /**
+   * Handoff hook to unpackr: inspects archive candidate without downloading blindly
+   */
+  public prepareUnpackrHandoff(
+    fileMeta: VaultrFileMetadata,
+    options: { maxBudgetBytes?: number; allowedExts?: string[] } = {}
+  ): { canHandoff: boolean; archivePath: string; includePatterns: string[]; reason?: string } {
+    const isArchive = ['zip', 'rar', '7z', 'tar'].some(ext =>
+      fileMeta.path.toLowerCase().endsWith(ext) || fileMeta.mimeOrExt.toLowerCase() === ext
+    );
+
+    if (!isArchive) {
+      return {
+        canHandoff: false,
+        archivePath: fileMeta.path,
+        includePatterns: [],
+        reason: 'Target is a direct media/book file, not an archive.'
+      };
+    }
+
+    const includePatterns = options.allowedExts || ['*.epub', '*.pdf', '*.mp3', '*.mp4', '*.flac'];
+
+    this.logRedacted('unpackr-handoff', `Preparing unpackr handoff for TorBox archive [${fileMeta.path}]`, {
+      path: fileMeta.path,
+      size: fileMeta.size
+    });
+
+    return {
+      canHandoff: true,
+      archivePath: fileMeta.path,
+      includePatterns
+    };
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new TorBoxExtension();
+}
