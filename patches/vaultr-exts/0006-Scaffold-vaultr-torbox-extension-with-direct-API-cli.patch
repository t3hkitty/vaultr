+++ b/tests/torbox.test.mjs
@@ -0,0 +1,132 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { TorBoxExtension } from '../dist/torbox/index.js';
+
+function createMockHost() {
+  const logs = [];
+  return {
+    log: (entry) => logs.push(entry),
+    getFiles: () => [],
+    getFileByPath: () => undefined,
+    saveSidecar: async () => {},
+    executeRclonePreview: () => {},
+    logs
+  };
+}
+
+test('TorBoxExtension safely redacts API tokens from host.log', () => {
+  const host = createMockHost();
+  const torbox = new TorBoxExtension({
+    apiKey: 'SECRET_API_KEY_12345'
+  });
+  torbox.init(host);
+
+  torbox.logRedacted('fetch', 'Requesting torrent with key SECRET_API_KEY_12345', {
+    token: 'SECRET_API_KEY_12345',
+    endpoint: '/torrents/mylist'
+  });
+
+  assert.equal(host.logs.length, 2);
+  const log = host.logs[1];
+  assert.equal(log.source, 'vaultr:torbox');
+  assert.ok(!log.message.includes('SECRET_API_KEY_12345'));
+  assert.ok(log.message.includes('[REDACTED_TORBOX_KEY]'));
+  assert.equal(log.meta.token, undefined);
+  assert.equal(log.meta.tokenRedacted, true);
+});
+
+test('TorBoxExtension parses torrents API response and generates .anymd YAML sidecars', () => {
+  const host = createMockHost();
+  const torbox = new TorBoxExtension();
+  torbox.init(host);
+
+  const mockApiResponse = {
+    success: true,
+    data: [
+      {
+        id: 101,
+        name: 'The_Expanse_Complete_EPUB',
+        size: 55000000,
+        hash: 'a1b2c3d4e5f6',
+        download_state: 'completed',
+        download_finished: true,
+        progress: 1.0,
+        created_at: '2026-11-20T12:00:00Z',
+        files: [
+          { id: 1, name: 'Leviathan_Wakes.epub', size: 2500000, hash: 'hash1' },
+          { id: 2, name: 'Calibans_War.epub', size: 2800000, hash: 'hash2' }
+        ]
+      }
+    ]
+  };
+
+  const torrents = torbox.parseTorrentsResponse(mockApiResponse);
+  assert.equal(torrents.length, 1);
+  assert.equal(torrents[0].name, 'The_Expanse_Complete_EPUB');
+
+  const sidecars = torbox.generateTorboxSidecars(torrents[0], { targetShelf: 'Scifi Books' });
+  assert.equal(sidecars.length, 2);
+  assert.equal(sidecars[0].path, 'tbox:/The_Expanse_Complete_EPUB/Leviathan_Wakes.epub');
+  assert.equal(sidecars[0].remote, 'tbox:');
+  assert.equal(sidecars[0].mimeOrExt, 'epub');
+  assert.equal(sidecars[0].ingest_source, 'torbox');
+  assert.ok(sidecars[0].virtual_folders.includes('TorBox Inbox'));
+  assert.ok(sidecars[0].virtual_folders.includes('Scifi Books'));
+  assert.equal(sidecars[0].custom.backend, 'torbox');
+  assert.equal(sidecars[0].custom.torbox_id, 101);
+});
+
+test('TorBoxExtension builds single-file requestdl URL and curl preview without leaking secret', () => {
+  const host = createMockHost();
+  const torbox = new TorBoxExtension({
+    apiKey: 'my_super_secret_token'
+  });
+  torbox.init(host);
+
+  const req = torbox.buildDownloadRequest(101, 2);
+  assert.ok(req.url.includes('torrent_id=101'));
+  assert.ok(req.url.includes('file_id=2'));
+  assert.ok(req.url.includes('token=my_super_secret_token'));
+  assert.equal(req.headers.Authorization, 'Bearer my_super_secret_token');
+  assert.ok(!req.fullCurlPreview.includes('my_super_secret_token'));
+  assert.ok(req.fullCurlPreview.includes('[REDACTED_KEY]'));
+});
+
+test('TorBoxExtension prepareUnpackrHandoff detects archives and configures includePatterns', () => {
+  const host = createMockHost();
+  const torbox = new TorBoxExtension();
+  torbox.init(host);
+
+  const archiveItem = {
+    path: 'tbox:/HugePack/bundle.zip',
+    remote: 'tbox:',
+    remotePath: 'HugePack/bundle.zip',
+    md5: 'hash999',
+    size: 8000000000,
+    mtime: '2026-11-22T00:00:00Z',
+    mimeOrExt: 'zip',
+    tags: []
+  };
+
+  const handoff = torbox.prepareUnpackrHandoff(archiveItem, {
+    allowedExts: ['*.epub', '*.pdf']
+  });
+
+  assert.equal(handoff.canHandoff, true);
+  assert.equal(handoff.archivePath, 'tbox:/HugePack/bundle.zip');
+  assert.deepEqual(handoff.includePatterns, ['*.epub', '*.pdf']);
+
+  const directEpub = {
+    path: 'tbox:/Books/single.epub',
+    remote: 'tbox:',
+    remotePath: 'Books/single.epub',
+    md5: 'hash777',
+    size: 2000000,
+    mtime: '2026-11-22T00:00:00Z',
+    mimeOrExt: 'epub',
+    tags: []
+  };
+
+  const directHandoff = torbox.prepareUnpackrHandoff(directEpub);
+  assert.equal(directHandoff.canHandoff, false);
+});
