+test('StagingBridgeExtension generates headless env vars from rclone authorize token JSON without disk writes', () => {
+  const host = createMockHost();
+  const bridge = new StagingBridgeExtension();
+  bridge.init(host);
+
+  const tokenBlob = JSON.stringify({
+    access_token: 'ya29.mock_token',
+    token_type: 'Bearer',
+    refresh_token: '1//04_refresh_token',
+    expiry: '2026-11-23T08:00:00Z'
+  });
+
+  const env = bridge.generateHeadlessEnvVars('gdrive-staging:', {
+    tokenJson: tokenBlob,
+    clientId: 'custom-client.apps.googleusercontent.com',
+    clientSecret: 'secret-1234',
+    scope: 'drive.file'
+  });
+
+  assert.equal(env.RCLONE_CONFIG_GDRIVE_STAGING_TYPE, 'drive');
+  assert.equal(env.RCLONE_CONFIG_GDRIVE_STAGING_SCOPE, 'drive.file');
+  assert.equal(env.RCLONE_CONFIG_GDRIVE_STAGING_CLIENT_ID, 'custom-client.apps.googleusercontent.com');
+  assert.equal(env.RCLONE_CONFIG_GDRIVE_STAGING_CLIENT_SECRET, 'secret-1234');
+  assert.equal(env.RCLONE_CONFIG_GDRIVE_STAGING_TOKEN, tokenBlob);
+
+  const dropboxTokenBlob = JSON.stringify({
+    access_token: 'sl.mock_dropbox_token',
+    refresh_token: 'dbx_refresh_123',
+    expiry: '2026-11-23T08:00:00Z'
+  });
+
+  const dbxEnv = bridge.generateHeadlessEnvVars('dbx-bridge:', {
+    tokenJson: dropboxTokenBlob
+  });
+
+  assert.equal(dbxEnv.RCLONE_CONFIG_DBX_BRIDGE_TYPE, 'dropbox');
+  assert.equal(dbxEnv.RCLONE_CONFIG_DBX_BRIDGE_TOKEN, dropboxTokenBlob);
+});
+
+test('StagingBridgeExtension plans 7z packing of .anymd files into .anymdz archive before upload', () => {
+  const host = createMockHost();
+  const bridge = new StagingBridgeExtension();
+  bridge.init(host);
+
+  const packPlan = bridge.planSevenZipPack(
+    ['/vault/book1.anymd', '/vault/book2.anymd'],
+    '/tmp/scratch',
+    'reading_batch'
+  );
+
+  assert.equal(packPlan.archiveName, 'reading_batch.anymdz');
+  assert.equal(packPlan.targetArchiveLocalPath, '/tmp/scratch/reading_batch.anymdz');
+  assert.equal(packPlan.packCommand, '7z a "/tmp/scratch/reading_batch.anymdz" "/vault/book1.anymd" "/vault/book2.anymd" -mx=7');
+  assert.equal(packPlan.expectedOutputExt, '.anymdz');
+});
+
