   /**
-   * Plans a two-hop transfer: Source -> Staging -> Destination
-   * Enforces: "Pack First, Hop Once" (packing into .anymdz or targeted list)
+   * Generates environment variables for headless, zero-config-file rclone execution.
+   * Maps out-of-band `rclone authorize` JSON tokens to RCLONE_CONFIG_<REMOTE>_* keys.
+   */
+  public generateHeadlessEnvVars(
+    remoteName: string,
+    credentials?: StagingOAuthCredentials
+  ): Record<string, string> {
+    const config = this.getStagingRemote(remoteName);
+    if (!config) {
+      throw new Error(`Staging remote "${remoteName}" is not registered.`);
+    }
+
+    const creds = credentials || config.credentials;
+    const cleanRemote = remoteName.replace(/:$/, '').toUpperCase().replace(/[^A-Z0-9]/g, '_');
+    const envVars: Record<string, string> = {};
+
+    if (config.backendType === 'gdrive') {
+      envVars[`RCLONE_CONFIG_${cleanRemote}_TYPE`] = 'drive';
+      envVars[`RCLONE_CONFIG_${cleanRemote}_SCOPE`] = creds?.scope || 'drive.file';
+    } else if (config.backendType === 'dropbox') {
+      envVars[`RCLONE_CONFIG_${cleanRemote}_TYPE`] = 'dropbox';
+    } else {
+      envVars[`RCLONE_CONFIG_${cleanRemote}_TYPE`] = config.backendType;
+    }
+
+    if (creds?.clientId) {
+      envVars[`RCLONE_CONFIG_${cleanRemote}_CLIENT_ID`] = creds.clientId;
+    }
+    if (creds?.clientSecret) {
+      envVars[`RCLONE_CONFIG_${cleanRemote}_CLIENT_SECRET`] = creds.clientSecret;
+    }
+
+    if (creds?.tokenJson) {
+      // Validate token JSON syntax
+      try {
+        JSON.parse(creds.tokenJson);
+      } catch {
+        throw new Error(`Invalid token JSON provided for headless remote ${remoteName}.`);
+      }
+      envVars[`RCLONE_CONFIG_${cleanRemote}_TOKEN`] = creds.tokenJson;
+    }
+
+    return envVars;
+  }
+
+  /**
+   * Plans a 7z packing command to bundle .anymd sidecars into a single .anymdz archive
+   * before upload. Avoids API rate-limiting on intermediary storage.
+   */
+  public planSevenZipPack(
+    sidecarFilePaths: string[],
+    outputDir: string,
+    archiveBaseName = 'sidecars'
+  ): SevenZipPackPlan {
+    if (sidecarFilePaths.length === 0) {
+      throw new Error('At least one sidecar file path must be specified to pack.');
+    }
+
+    const cleanBase = archiveBaseName.replace(/\.anymdz$/, '').replace(/\.7z$/, '');
+    const archiveName = `${cleanBase}.anymdz`;
+    const targetArchiveLocalPath = `${outputDir.replace(/[\/\\]$/, '')}/${archiveName}`;
+
+    // 7z a archive.anymdz file1.anymd file2.anymd -mx=7
+    const escapedFiles = sidecarFilePaths.map(p => `"${p}"`).join(' ');
+    const packCommand = `7z a "${targetArchiveLocalPath}" ${escapedFiles} -mx=7`;
+
+    return {
+      archiveName,
+      targetArchiveLocalPath,
+      filesToPack: [...sidecarFilePaths],
+      packCommand,
+      expectedOutputExt: '.anymdz'
+    };
+  }
+
+  /**
+   * Plans a two-hop transfer: Source -> Intermediary Staging -> Destination
+   * Enforces: "Pack First, Hop Once" and strict Quota Guards (<90% threshold and hard ceiling).
    */
   public planStagingHop(
     sourceRemotePath: string,
