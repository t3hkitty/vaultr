+      });
+      throw new Error(err);
+    }
+
+    // 90% threshold warning
+    if (stagingConfig.maxQuotaBytes && (currentUsed + options.totalBytes) > (stagingConfig.maxQuotaBytes * 0.9)) {
       this.hostApi.log({
         timestamp: new Date().toISOString(),
         level: 'warn',
-        source: 'vaultr:staging-bridge',
