@@ -0,0 +1,230 @@
+import type {
+  IVaultrSubExtension,
+  VaultrExtensionManifest,
+  VaultrExtensionHostApi
+} from '../types.js';
+import type {
+  StagingRemoteConfig,
+  StagingHopRecord,
+  StagingQuotaStatus
+} from './types.js';
+
+export class StagingBridgeExtension implements IVaultrSubExtension {
+  public manifest: VaultrExtensionManifest = {
+    id: 'vaultr-staging-bridge',
+    name: 'Staging & Sync Bridge (Free GDrive/Dropbox Intermediary)',
+    version: '0.1.0',
+    description: 'Manages no-subscription transient cloud staging hops (Google Drive, Dropbox) for .anymdz archives and batches with Pack-First, Verify-Destination, and Auto-Prune rules.',
+    category: 'storage',
+    author: 't3hkitty',
+    entrypoint: 'extensions/staging/index.ts',
+    sourceUrl: 'https://github.com/t3hkitty/vaultr-exts/tree/main/extensions/staging',
+    enabledByDefault: true,
+    capabilities: [
+      'pack-first-hop',
+      'verify-after-clear',
+      'quota-guard',
+      'rclone-staging-builder'
+    ]
+  };
+
+  private hostApi!: VaultrExtensionHostApi;
+  private stagingRemotes = new Map<string, StagingRemoteConfig>();
+  private activeHops = new Map<string, StagingHopRecord>();
+
+  public init(api: VaultrExtensionHostApi): void {
+    this.hostApi = api;
+
+    // Register standard free-tier presets
+    this.registerStagingRemote({
+      remoteName: 'gdrive-staging:',
+      backendType: 'gdrive',
+      stagingRoot: 'vaultr_stage/',
+      maxQuotaBytes: 15 * 1024 * 1024 * 1024, // 15 GB
+      retentionHours: 24,
+      autoPruneAfterVerify: true,
+      packFirstAnymdz: true
+    });
+
+    this.registerStagingRemote({
+      remoteName: 'dbx-bridge:',
+      backendType: 'dropbox',
+      stagingRoot: 'vaultr_stage/',
+      maxQuotaBytes: 2 * 1024 * 1024 * 1024, // 2 GB
+      retentionHours: 12,
+      autoPruneAfterVerify: true,
+      packFirstAnymdz: true
+    });
+
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr:staging-bridge',
+      stage: 'init',
+      message: 'Staging Bridge extension initialized with gdrive-staging: (15GB) and dbx-bridge: (2GB) presets.'
+    });
+  }
+
+  public registerStagingRemote(config: StagingRemoteConfig): void {
+    const key = config.remoteName.toLowerCase().replace(/:$/, '') + ':';
+    this.stagingRemotes.set(key, config);
+  }
+
+  public getStagingRemote(name: string): StagingRemoteConfig | undefined {
+    const key = name.toLowerCase().replace(/:$/, '') + ':';
+    return this.stagingRemotes.get(key);
+  }
+
+  public getAllStagingRemotes(): StagingRemoteConfig[] {
+    return Array.from(this.stagingRemotes.values());
+  }
+
+  /**
+   * Plans a two-hop transfer: Source -> Staging -> Destination
+   * Enforces: "Pack First, Hop Once" (packing into .anymdz or targeted list)
+   */
+  public planStagingHop(
+    sourceRemotePath: string,
+    stagingRemoteName: string,
+    destinationRemotePath: string,
+    options: {
+      isPackedAnymdz?: boolean;
+      packedArchiveName?: string;
+      totalBytes: number;
+      checksumMd5: string;
+    }
+  ): {
+    hopRecord: StagingHopRecord;
+    stageCommand: string;
+    destPullCommand: string;
+    pruneCommand: string;
+  } {
+    const stagingConfig = this.getStagingRemote(stagingRemoteName);
+    if (!stagingConfig) {
+      throw new Error(`Staging remote "${stagingRemoteName}" is not registered in StagingBridge.`);
+    }
+
+    // Quota guard check
+    if (stagingConfig.maxQuotaBytes && options.totalBytes > stagingConfig.maxQuotaBytes * 0.9) {
+      this.hostApi.log({
+        timestamp: new Date().toISOString(),
+        level: 'warn',
+        source: 'vaultr:staging-bridge',
+        stage: 'quota-guard',
+        message: `Transfer size (${options.totalBytes} B) exceeds 90% of free staging quota for ${stagingRemoteName}. Recommend direct transfer or chunking.`,
+        meta: { totalBytes: options.totalBytes, maxQuota: stagingConfig.maxQuotaBytes }
+      });
+    }
+
+    const hopId = `hop_${Date.now()}`;
+    const filename = options.packedArchiveName || sourceRemotePath.split(/[\/\\]/).pop() || 'staged_payload';
+    const stagingPath = `${stagingConfig.stagingRoot.replace(/\/$/, '')}/${filename}`;
+    const fullStagingRemotePath = `${stagingConfig.remoteName}${stagingPath}`;
+
+    const hopRecord: StagingHopRecord = {
+      hopId,
+      sourceRemotePath,
+      stagingRemotePath: fullStagingRemotePath,
+      destinationRemotePath,
+      isPackedAnymdz: options.isPackedAnymdz ?? true,
+      packedArchiveName: options.packedArchiveName,
+      manifestChecksumMd5: options.checksumMd5,
+      totalBytes: options.totalBytes,
+      createdAt: new Date().toISOString(),
+      status: 'staged'
+    };
+
+    this.activeHops.set(hopId, hopRecord);
+
+    // 1. Source -> Staging
+    const stageCommand = `rclone copyto "${sourceRemotePath}" "${fullStagingRemotePath}" --dry-run`;
+
+    // 2. Staging -> Destination
+    const destPullCommand = `rclone copyto "${fullStagingRemotePath}" "${destinationRemotePath}" --checksum --dry-run`;
+
+    // 3. Auto-Prune Staging (Clear After Verify)
+    const pruneCommand = `rclone deletefile "${fullStagingRemotePath}" --dry-run`;
+
+    return {
+      hopRecord,
+      stageCommand,
+      destPullCommand,
+      pruneCommand
+    };
+  }
+
+  /**
+   * Confirms destination arrival against MD5 checksum and prunes intermediary copy
+   */
+  public verifyAndPrune(
+    hopId: string,
+    destinationObservedMd5: string
+  ): { success: boolean; shouldPrune: boolean; pruneCommand?: string; error?: string } {
+    const hop = this.activeHops.get(hopId);
+    if (!hop) {
+      return { success: false, shouldPrune: false, error: `Hop ${hopId} not found.` };
+    }
+
+    if (hop.manifestChecksumMd5.toLowerCase() !== destinationObservedMd5.toLowerCase()) {
+      this.hostApi.log({
+        timestamp: new Date().toISOString(),
+        level: 'error',
+        source: 'vaultr:staging-bridge',
+        stage: 'verify',
+        message: `Destination checksum mismatch for hop ${hopId}! Expected: ${hop.manifestChecksumMd5}, Got: ${destinationObservedMd5}. Halting auto-prune.`,
+        meta: { hopId }
+      });
+      hop.status = 'failed';
+      return { success: false, shouldPrune: false, error: 'Checksum mismatch on destination' };
+    }
+
+    hop.status = 'verified_at_dest';
+    hop.verifiedAt = new Date().toISOString();
+
+    const pruneCommand = `rclone deletefile "${hop.stagingRemotePath}"`;
+    hop.status = 'pruned';
+    hop.prunedAt = new Date().toISOString();
+
+    this.hostApi.log({
+      timestamp: new Date().toISOString(),
+      level: 'info',
+      source: 'vaultr:staging-bridge',
+      stage: 'prune',
+      message: `Verified destination for hop ${hopId}. Staging file ${hop.stagingRemotePath} pruned to preserve free quota.`,
+      meta: { hopId, stagingPath: hop.stagingRemotePath }
+    });
+
+    return {
+      success: true,
+      shouldPrune: true,
+      pruneCommand
+    };
+  }
+
+  /**
+   * Evaluates quota status across staging remotes
+   */
+  public getQuotaStatus(remoteName: string, currentUsedBytes = 0): StagingQuotaStatus {
+    const config = this.getStagingRemote(remoteName);
+    const quotaBytes = config?.maxQuotaBytes || 15 * 1024 * 1024 * 1024;
+    const available = Math.max(0, quotaBytes - currentUsedBytes);
+    const percent = quotaBytes > 0 ? (currentUsedBytes / quotaBytes) * 100 : 0;
+
+    const stagedItemsCount = Array.from(this.activeHops.values()).filter(
+      h => h.stagingRemotePath.startsWith(remoteName) && h.status === 'staged'
+    ).length;
+
+    return {
+      remoteName,
+      usedBytes: currentUsedBytes,
+      quotaBytes,
+      availableBytes: available,
+      percentUsed: parseFloat(percent.toFixed(1)),
+      stagedItemsCount
+    };
+  }
+}
+
+export default function createExtension(): IVaultrSubExtension {
+  return new StagingBridgeExtension();
+}
