@@ -0,0 +1,37 @@
+export type StagingBackendType = 'gdrive' | 'dropbox' | 'webdav' | 'local' | 'generic';
+
+export interface StagingRemoteConfig {
+  remoteName: string;          // e.g. 'gdrive-staging:' or 'dbx-bridge:'
+  backendType: StagingBackendType;
+  stagingRoot: string;         // e.g. 'vaultr_stage/'
+  maxQuotaBytes?: number;      // e.g. 15 * 1024 * 1024 * 1024 for 15GB free Google Drive, or 2GB for Dropbox
+  retentionHours?: number;     // e.g. 24h default before auto-cleanup alert
+  autoPruneAfterVerify?: boolean; // Default true: Clear after destination manifest verification
+  packFirstAnymdz?: boolean;   // Default true: Pack into .anymdz before transferring
+}
+
+export type StageHopStatus = 'staged' | 'verified_at_dest' | 'pruned' | 'failed';
+
+export interface StagingHopRecord {
+  hopId: string;
+  sourceRemotePath: string;
+  stagingRemotePath: string;
+  destinationRemotePath: string;
+  isPackedAnymdz: boolean;
+  packedArchiveName?: string;
+  manifestChecksumMd5: string;
+  totalBytes: number;
+  createdAt: string;
+  status: StageHopStatus;
+  verifiedAt?: string;
+  prunedAt?: string;
+}
+
+export interface StagingQuotaStatus {
+  remoteName: string;
+  usedBytes: number;
+  quotaBytes: number;
+  availableBytes: number;
+  percentUsed: number;
+  stagedItemsCount: number;
+}
