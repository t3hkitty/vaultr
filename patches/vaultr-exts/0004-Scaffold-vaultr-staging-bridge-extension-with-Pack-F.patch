diff --git a/tests/staging.test.mjs b/tests/staging.test.mjs
new file mode 100644
index 0000000..3abbb49
--- /dev/null
+++ b/tests/staging.test.mjs
@@ -0,0 +1,93 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { StagingBridgeExtension } from '../dist/staging/index.js';
+
+function createMockHost() {
+  const logs = [];
+  return {
+    log: (entry) => logs.push(entry),
+    getFiles: () => [],
+    getFileByPath: () => undefined,
+    saveSidecar: async () => {},
+    executeRclonePreview: () => {},
+    logs
+  };
+}
+
+test('StagingBridgeExtension registers free-tier presets (gdrive-staging 15GB, dbx-bridge 2GB)', () => {
+  const host = createMockHost();
+  const bridge = new StagingBridgeExtension();
+  bridge.init(host);
+
+  const gdrive = bridge.getStagingRemote('gdrive-staging:');
+  assert.ok(gdrive !== undefined);
+  assert.equal(gdrive.backendType, 'gdrive');
+  assert.equal(gdrive.maxQuotaBytes, 15 * 1024 * 1024 * 1024);
+  assert.equal(gdrive.packFirstAnymdz, true);
+
+  const dbx = bridge.getStagingRemote('dbx-bridge:');
+  assert.ok(dbx !== undefined);
+  assert.equal(dbx.backendType, 'dropbox');
+  assert.equal(dbx.maxQuotaBytes, 2 * 1024 * 1024 * 1024);
+});
+
+test('StagingBridgeExtension plans two-hop Pack-First transfer with auto-prune command', () => {
+  const host = createMockHost();
+  const bridge = new StagingBridgeExtension();
+  bridge.init(host);
+
+  const plan = bridge.planStagingHop(
+    'local:/vault/sidecars.anymdz',
+    'gdrive-staging:',
+    'koofr:/backups/sidecars.anymdz',
+    {
+      isPackedAnymdz: true,
+      packedArchiveName: 'sidecars.anymdz',
+      totalBytes: 50 * 1024 * 1024, // 50MB
+      checksumMd5: 'abcd1234abcd1234'
+    }
+  );
+
+  assert.equal(plan.hopRecord.status, 'staged');
+  assert.equal(plan.stageCommand, 'rclone copyto "local:/vault/sidecars.anymdz" "gdrive-staging:vaultr_stage/sidecars.anymdz" --dry-run');
+  assert.equal(plan.destPullCommand, 'rclone copyto "gdrive-staging:vaultr_stage/sidecars.anymdz" "koofr:/backups/sidecars.anymdz" --checksum --dry-run');
+  assert.equal(plan.pruneCommand, 'rclone deletefile "gdrive-staging:vaultr_stage/sidecars.anymdz" --dry-run');
+});
+
+test('StagingBridgeExtension verifyAndPrune verifies destination MD5 and generates deletefile command', () => {
+  const host = createMockHost();
+  const bridge = new StagingBridgeExtension();
+  bridge.init(host);
+
+  const plan = bridge.planStagingHop(
+    'local:/vault/manifest.anymd',
+    'dbx-bridge:',
+    'davjump:/vault/manifest.anymd',
+    {
+      totalBytes: 1024,
+      checksumMd5: 'deadbeef9999'
+    }
+  );
+
+  // Mismatched checksum should fail and prevent pruning
+  const mismatchResult = bridge.verifyAndPrune(plan.hopRecord.hopId, 'wrong_hash');
+  assert.equal(mismatchResult.success, false);
+  assert.equal(mismatchResult.shouldPrune, false);
+
+  // Matched checksum should succeed and return real prune command
+  const matchResult = bridge.verifyAndPrune(plan.hopRecord.hopId, 'deadbeef9999');
+  assert.equal(matchResult.success, true);
+  assert.equal(matchResult.shouldPrune, true);
+  assert.ok(matchResult.pruneCommand?.includes('rclone deletefile "dbx-bridge:vaultr_stage/manifest.anymd"'));
+});
+
+test('StagingBridgeExtension calculates quota usage status correctly', () => {
+  const host = createMockHost();
+  const bridge = new StagingBridgeExtension();
+  bridge.init(host);
+
+  const quota = bridge.getQuotaStatus('dbx-bridge:', 500 * 1024 * 1024); // 500 MB used of 2GB
+  assert.equal(quota.remoteName, 'dbx-bridge:');
+  assert.equal(quota.usedBytes, 500 * 1024 * 1024);
+  assert.equal(quota.percentUsed, 24.4);
+});
